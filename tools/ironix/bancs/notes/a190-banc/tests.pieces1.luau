---------------------------------------------------------------- scénario « pieces1 » : Pieces = 1, l'ancien « +2 Speed/s »
P1:SetAttribute("Cash", 100)
P1:SetAttribute("Income", 10)
P1:SetAttribute("Speed", 10)
P1:SetAttribute("WalkSpeed", 16)
P1:SetAttribute("Damage", 1)
P1:SetAttribute("CashCollected", 0)
local hud = makeHud()
local Hud = requireModule(HUD_MODULE, "client")
local Gain = requireModule(GAIN_MODULE, "client")
taskLib.spawn(Hud.Start)
taskLib.spawn(Gain.Start)
step(0.1)
print("\n== Q1. Pieces = 1 : un seul BB_Gain « +2 Speed/s », vie FloatGain.Time")
check(HudCfgC.TreadmillGain.Pieces == 1, "Q1a copie des sources : Pieces = 1")
P1:SetAttribute("TrainingMachine", "Treadmill")
P1:SetAttribute("Speed", 12)
local list = childrenNamed(PLAYER_GUI, "BB_Gain")
check(#list == 1 and el(list[1], "Amount").Text == "+2 Speed/s", `Q1b « +2 Speed/s » ({list[1] and el(list[1], "Amount").Text})`)
step(0.9)
check(#childrenNamed(PLAYER_GUI, "BB_Gain") == 1, "Q1c encore là à 0,9 s (FloatGain.Time = 1)")
check(scaleNamed(el(hud, "SpeedRow"), UiMotionC.PopScaleName) == nil, "Q1d pas de pulsation de SpeedRow")
step(0.3)
check(#childrenNamed(PLAYER_GUI, "BB_Gain") == 0, "Q1e puis parti")
summary()
