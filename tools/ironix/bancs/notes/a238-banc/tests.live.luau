--!nocheck
-- Scénario « live » d'a238 (pre.live.luau d'a208 : boutique ouverte, paliers d'Ouvrir maintenant 8101 à 8104).
addGlow()
startClient()
section("a238 live : Ouvrir maintenant")
openShop()
local openNow = v2Card(V2, "OpenNow")
local buy = openNow:FindFirstChild("BuyButton")
check(buy.Visible == true and textOf(openNow, "Price") == "19", `1b sans objet qui attend : bouton visible, prix du premier palier ({textOf(openNow, "Price")})`)
click(buy)
check(textOf(openNow, "Price") == "No item" and #MARKET.prompts == 0 and GLOW.calls == 0, `1b clic sans objet : « No item », aucune fenêtre ni lueur ({textOf(openNow, "Price")})`)
advance(2.2)
check(textOf(openNow, "Price") == "19" and buy.Visible == true, `1b 2 s après : le prix revient ({textOf(openNow, "Price")})`)
P1:SetAttribute("OpenNowReadyAt", serverTime() + 5)
advance(1.1)
check(buy.Visible == true and textOf(openNow, "Price") == "19", `1b objet presque prêt (5 s) : bouton, premier palier ({textOf(openNow, "Price")})`)
click(buy)
check(textOf(openNow, "Price") == "Almost ready" and #MARKET.prompts == 0, `1b clic presque prêt : « Almost ready » ({textOf(openNow, "Price")})`)
P1:SetAttribute("OpenNowReadyAt", serverTime() + 100)
advance(2.2)
check(buy.Visible == true and textOf(openNow, "Price") == "39", `1b attente de 100 s : palier à 39 ({textOf(openNow, "Price")})`)
click(buy)
local last = MARKET.prompts[#MARKET.prompts]
check(#MARKET.prompts == 1 and last.kind == "Product" and last.id == 8102 and GLOW.calls == 1, "1b attente de 100 s : fenêtre du palier 8102, lueur")
summary("scénario live")
