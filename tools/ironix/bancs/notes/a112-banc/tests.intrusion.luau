--!nocheck
-- Banc a112 (vague 33, Cantin 2026-11-13) : vol entre joueurs sans chrono et alerte d'intrusion.
--   1. Boutique d'un joueur : ni HeistTimer (casse ou fenêtre de vol) ni StealEndsAt ; toujours ouverte au
--      vol bien après 10 s ; la porte reste cassée tant qu'un intrus est dedans, puis se refait une fois vide.
--   2. Magasin PNJ : le chrono de casse (Balance.Window.BreakTimer) part toujours au premier coup.
--   3. Alerte de la victime dès la casse (TheftAlert(true, casseur, nil)), à l'entrée d'un autre intrus, retirée
--      à sa sortie (false puis réannonce), remplacée par l'objet à la prise ; la batte d'Ada s'équipe.
-- La boutique du bot (aucune alerte) est vérifiée dans la copie a112 du banc a96.

-- Magasin PNJ de la zone 1, posé avant le démarrage du serveur (WindowService l'enregistre au départ).
local store = make("Model", { Name = "STORE_Z1_BancA112" })
make("Part", { Name = "Window", Anchored = true, CFrame = CFrame.new(-300, 4, 0), Size = Vector3.new(10, 6, 0.4) }, store)
store:SetAttribute("Zone", 1)
addTag(store, "NPCStore")
store.Parent = MAP

startServer()
local Balance = sharedModule("Config/Balance")

local ada = join("Ada", victimProfile())
local bob = join("Bob", newProfile())
local cy = join("Cy", newProfile())
giveBat(ada)
startClient(ada)
advance(1.2)
local adaShop = shopOf(ada)
local adaBounds = adaShop:FindFirstChild("Bounds")
local adaDoor = windowIdOf(adaShop)

local function alertsTo(player)
	return theftAlerts(player)
end

section("magasin PNJ : chrono de casse inchangé")
local storeId = WindowService.GetWindowId(store)
check(storeId == "STORE_Z1_BancA112", `magasin PNJ enregistré (trouvé {storeId})`)
moveTo(bob, Vector3.new(-300, 3, -4))
local tool = giveTool(bob)
local t0 = Workspace:GetServerTimeNow()
fireAs(bob, "HitWindow", storeId)
flush()
local npcTimers = remotes("HeistTimer", function(e)
	return e.to == bob and e.args[1] == storeId and e.args[2] > 0
end)
check(#npcTimers == 1, "premier coup sur une vitrine PNJ : HeistTimer envoyé au frappeur")
check(#npcTimers == 1 and near(npcTimers[1].args[2] - t0, Balance.Window.BreakTimer, 0.3), `chrono de casse de {Balance.Window.BreakTimer} s`)
tool:Destroy()
advance(0.5)

section("casse de la porte d'Ada : alerte d'intrusion, sans chrono")
local beforeAlerts = #alertsTo(ada)
check(breakDoor(bob, adaShop), "Bob casse la porte d'Ada")
check(#remotes("HeistTimer", function(e) return e.args[1] == adaDoor end) == 0, "aucun HeistTimer pour la porte d'un joueur (ni casse ni vol)")
check(adaShop:GetAttribute("StealOpen") == true and adaShop:GetAttribute("StealEndsAt") == nil, "ouverte au vol, sans StealEndsAt")
advance(0.15)
local list = alertsTo(ada)
check(#list == beforeAlerts + 1 and list[#list].args[1] == true and list[#list].args[2] == bob and list[#list].args[3] == nil, "Ada reçoit TheftAlert(true, Bob, nil) dès la casse")
check(#notifies(ada, "Bob smashed your shop door!") == 1, "l'alarme de base (Notify) reste")
local s = state()
check(s.Active and s.Thief == bob and s.ItemId == "" and s.Headline == "BOB IS STEALING YOUR SHOP!", `écran d'Ada : « BOB IS STEALING YOUR SHOP! » (trouvé {s.Headline})`)
check(holdsBat(ada), "la batte d'Ada s'équipe toute seule")
local ids = PvPService.GetIntruders(ada)
check(#ids == 1 and ids[1] == bob, "GetIntruders(Ada) = { Bob }")
advance(1)
check(#alertsTo(ada) == beforeAlerts + 1, "pas de nouvel envoi tant que rien ne change")

section("un autre intrus entre puis sort")
moveTo(cy, SHOPS[1].S.center)
advance(0.15)
list = alertsTo(ada)
check(list[#list].args[1] == true and list[#list].args[2] == cy and list[#list].args[3] == nil, "Cy entre : TheftAlert(true, Cy, nil)")
ids = PvPService.GetIntruders(ada)
check(#ids == 2 and ids[1] == bob and ids[2] == cy, "intrus dans l'ordre d'arrivée : Bob, Cy")
frame()
check(state().Thief == cy and state().Thefts == 2, "le dernier annoncé (Cy) est affiché")
local n = #alertsTo(ada)
moveTo(cy, SHOPS[3].S.center)
advance(0.15)
list = alertsTo(ada)
check(#list == n + 2 and list[n + 1].args[1] == false and list[n + 2].args[2] == bob and list[n + 2].args[3] == nil, "Cy sort : TheftAlert(false) puis réannonce (true, Bob, nil)")
frame()
check(state().Active and state().Thief == bob and state().Thefts == 1, "l'alerte reste, sur Bob")

section("prise d'un objet : l'alerte avec l'objet remplace l'intrusion")
n = #alertsTo(ada)
check(steal(bob, adaShop, 1), "Bob prend la Canette")
advance(0.3)
list = alertsTo(ada)
check(#list == n + 1 and list[n + 1].args[2] == bob and list[n + 1].args[3] == "Z1_CanetteDeSoda", "un seul envoi : TheftAlert(true, Bob, Z1_CanetteDeSoda), sans false")
check(#PvPService.GetIntruders(ada) == 0, "Bob voleur n'est plus compté comme intrus")
frame()
check(state().ItemId == "Z1_CanetteDeSoda" and state().Headline == "BOB IS STEALING YOUR SODA CAN!", "écran : la Canette")

section("pas de chrono : toujours ouverte, porte cassée tant qu'un intrus est dedans")
advance(40, 0.5)
check(adaShop:GetAttribute("StealOpen") == true and WindowService.IsBroken(adaDoor), "40 s plus tard (Bob dedans) : toujours ouverte, porte cassée")
moveTo(cy, SHOPS[1].S.center)
CarryService.Fail(bob, "Bat")
flush()
moveTo(bob, SHOPS[2].S.center)
advance(40, 0.5)
check(WindowService.IsBroken(adaDoor) and adaShop:GetAttribute("StealOpen") == true, "80 s : Cy dedans, toujours cassée (pas de limite d'attente)")
check(steal(cy, adaShop, 1), "Cy peut encore voler 80 s après la casse")
CarryService.Fail(cy, "Bat")
flush()
moveTo(cy, SHOPS[3].S.center)
advance(0.6)
check(not WindowService.IsBroken(adaDoor), "boutique vide : la porte se refait")
check(adaShop:GetAttribute("StealOpen") == nil, "fenêtre de vol fermée")
frame()
list = alertsTo(ada)
check(list[#list].args[1] == false and not state().Active, "plus d'intrus : alerte finie")
check(#PvPService.GetIntruders(ada) == 0, "GetIntruders vide")

section("sortie")
check(not logHas("mal formé", "WARN"), "aucun envoi de remote mal formé (Net, en Studio)")
check(not logHas("tick :", "WARN"), "aucune erreur dans les boucles des services")
check(not logHas("[TheftAlertController]", "WARN"), "aucune erreur du contrôleur")
summary("scénario intrusion")
