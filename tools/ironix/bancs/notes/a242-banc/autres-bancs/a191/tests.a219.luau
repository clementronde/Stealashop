--!nocheck
-- Scénario « a219 » (vague 66, L-210 point 2 « bloqués à vie », 2026-11-16) : Config/Displayed V0 allumés.
--   ReserveCatchAll : un objet libre qui manque à la réserve y entre (boucle d'une seconde), les plus rentables
--     d'abord ; l'objet en main (attribut HeldItem) n'y est pas, rangé il y revient ; jamais un objet sous antivol ;
--   client : l'objet sous antivol pas encore posé est listé avec « PLACE », qui ferme le panneau et lance la pose au sol ;
--   SwapWhenFull : DisplayButton sans présentoir libre : échange avec l'exposé le moins rentable (à égalité, le plus
--     grand numéro), qui prend sa place dans la réserve ; Notify « … moved to your reserve ».
advance(1000)
startServer()
local Displayed = sharedModule("Config/Displayed")
local HeldAttr = sharedModule("Config/HeldItem").PlayerAttribute
local DisplayService = serverModule("DisplayService")

section("Config/Displayed (V0)")
check(Displayed.ReserveCatchAll == true and Displayed.SwapWhenFull == true, "ReserveCatchAll et SwapWhenFull allumés")
check(Displayed.LockedButtonText == "PLACE", `LockedButtonText « {Displayed.LockedButtonText} »`)

section("objet libre arrivé hors réserve : il y entre ; jamais l'objet sous antivol")
local data, C1, E3 = a219Profile()
local ada = join("Ada", data)
advance(1.5)
check(a219Reserve(ada) == "c2", `c2 entré dans la réserve au chargement, pas at1 (« {a219Reserve(ada)} »)`)
check(ada:GetAttribute("DisplayReserve") == "c2", "attribut DisplayReserve")
addItem(dataOf(ada), "k1", C1, nil, 1, 7)
addItem(dataOf(ada), "k2", E3, nil, 3, 8)
advance(1.2)
check(a219Reserve(ada) == "c2,k2,k1", `deux objets arrivés : au bout, l'Épique d'abord (« {a219Reserve(ada)} »)`)

section("objet en main : hors réserve ; rangé : il revient au bout")
ada:SetAttribute(HeldAttr, "c2")
advance(1.2)
check(a219Reserve(ada) == "k2,k1" and ada:GetAttribute("DisplayReserve") == "k2,k1", `c2 en main : sorti (« {a219Reserve(ada)} »)`)
check(table.find(DisplayService.GetReserve(ada), "c2") == nil, "GetReserve sans c2")
local _, why = DisplayService.PlaceFromReserve(ada, "c2")
check(why == "NotInReserve", `PlaceFromReserve(c2) en main : refusé ({why})`)
check(DisplayService.AddToReserve(ada, "c2") == false, "AddToReserve(c2) en main : refusé")
ada:SetAttribute(HeldAttr, nil)
advance(1.2)
check(a219Reserve(ada) == "k2,k1,c2", `rangé : c2 revient au bout (« {a219Reserve(ada)} »)`)

section("client : l'objet sous antivol est listé avec « PLACE »")
local gui = a219Gui(ada:FindFirstChildOfClass("PlayerGui"))
startClient(ada)
advance(0.6)
local Controller = clientModule("DisplayedController")
local Fake = clientModule("InventoryController")
Controller.Toggle()
flush()
check(gui.Enabled == true and a219Rows(gui) == 4, `réserve : 3 objets + at1 (trouvé {a219Rows(gui)})`)
local locked = a219Row(gui, "at1")
check(locked ~= nil and locked.DisplayButton.DisplayLabel.Text == "PLACE", "at1 : « PLACE »")
local free = a219Row(gui, "c2")
check(free ~= nil and free.DisplayButton.DisplayLabel.Text == "DISPLAY", "c2 : « DISPLAY » de Clément gardé")
check(gui.Panel.Reserve.ReserveCount.ReserveCountLabel.Text == "4", "ReserveCountLabel « 4 »")
local sent = #serverCalls("PlaceFromReserve")
click(locked.DisplayButton)
advance(0.3)
check(#serverCalls("PlaceFromReserve") == sent, "PLACE : rien envoyé au serveur")
check(Fake.Calls[1] == "at1", `InventoryController.PlaceItem(at1) ({Fake.Calls[1]})`)
check(gui.Enabled == false and not Controller.IsOpen(), "panneau fermé")

section("DisplayButton, présentoirs tous pris : échange avec le moins rentable (à égalité, le plus grand numéro)")
Controller.Toggle()
flush()
advance(1.2)
click(a219Row(gui, "k2").DisplayButton)
advance(1.2)
local shown = a219Displayed(ada)
check(shown.k2 == 4 and shown.c1 == nil and shown.c1a == 3, `k2 prend le présentoir 4 de c1 (Communs à égalité : le 4) ({shown.k2})`)
check(a219Reserve(ada) == "c1,k1,c2", `c1 prend la place de k2 dans la réserve (« {a219Reserve(ada)} »)`)
check(#notifies(ada, "moved to your reserve") == 1, "Notify « … placed on a display, … moved to your reserve »")
check(dataOf(ada).Items.c1 ~= nil and countKeys(dataOf(ada).Items) == 8, "rien ne quitte Items")
check(a219Row(gui, "c1") ~= nil and a219Row(gui, "k2") == nil, "panneau à jour")
advance(1.2)
click(a219Row(gui, "c1").DisplayButton)
advance(1.2)
shown = a219Displayed(ada)
check(shown.c1 == 3 and shown.c1a == nil and shown.k2 == 4 and a219Reserve(ada) == "c1a,k1,c2", `2e échange : c1 prend le présentoir 3 de c1a, le moins rentable (« {a219Reserve(ada)} »)`)

section("revenu suivi")
local income = DisplayService.GetIncome(ada)
check(type(income) == "number" and income > 0, `GetIncome {income}`)
check(not logHas("attempt to", ""), "aucune erreur")

summary("scénario a219")
