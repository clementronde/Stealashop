--!nocheck
-- Scénario « place » du banc a432 (Cantin, 24/11 : « plus de carré ») : pendant la pose d'un objet sous antivol, aucune
-- pièce BoxGhost au sol ; un clic ou un appui pose au point visé ; le serveur refuse ce qui n'est pas valide (Notify
-- « Warning » : toast et son UI_Deny) et cherche lui-même le sol, quel que soit le point envoyé.
local ada, Inventory = a432Start()
local UnboxConfig = sharedModule("Config/Unbox", "client")
local S = refsOfShop(shopOf(ada))

section("interrupteur")
check(UnboxConfig.PlaceGhost == false, `Config/Unbox.PlaceGhost = false par défaut (V0 proposé, Cantin 24/11) ({tostring(UnboxConfig.PlaceGhost)})`)

section("mode pose, visée hors de sa boutique : pas de carré, refus du serveur")
local uid = bringItem(ada, "Z3_Smartphone", "Rare", 3)
check(uid ~= nil and dataOf(ada).Items[uid].AntiTheft == true and dataOf(ada).Items[uid].Spot == nil, "objet sous antivol dans l'inventaire")
Inventory.StartPlacing(uid)
advance(0.1)
check(Inventory.GetState().Placing == uid, "mode pose de l'objet")
aimAt(floorPoint(ada, 6, 60)) -- hors de sa boutique
advance(0.2)
check(not ghostShown(), "aucun carré au sol hors de sa boutique")
check(Inventory.GetState().Aim ~= nil and Inventory.GetState().AimValid == false, "la visée est calculée (Aim, AimValid = false)")
local calls = #serverCalls("PlaceBox")
local told = #notifies(ada)
worldClick()
flush()
advance(0.3)
check(#serverCalls("PlaceBox") == calls + 1, "clic : PlaceBox envoyé (le serveur juge)")
check(dataOf(ada).Items[uid].Spot == nil, "refusé par le serveur : rien posé")
local refusal = lastNotify(ada)
check(#notifies(ada) > told and refusal and string.find(refusal.args[1], "inside your own shop", 1, true) and refusal.args[2] == "Warning", `refus compris : Notify « Warning » ({refusal and refusal.args[1]})`)
check(Inventory.GetState().Placing == uid and not ghostShown(), "le mode reste pour réessayer, toujours sans carré")

section("clic au sol de sa boutique : posé à ce point")
local target = floorPoint(ada, 18, 20)
standNear(ada, target)
aimAt(target)
advance(0.2)
check(not ghostShown(), "aucun carré au sol dans sa boutique")
check(Inventory.GetState().AimValid == true, "visée valable (AimValid)")
worldClick()
flush()
advance(0.6)
local entry = dataOf(ada).Items[uid]
local model = floorItemOf(ada, uid)
check(entry.Spot ~= nil and model ~= nil, "posé au sol, antivol lancé")
check(model and xzDistance(model:GetPivot().Position, target) < 0.05, `posé au point cliqué ({model and model:GetPivot().Position})`)
check(Inventory.GetState().Placing == nil and not ghostShown(), "posé : fin du mode pose, aucun carré")

section("appui sur téléphone : posé, sans carré")
local uid2 = bringItem(ada, "Z3_TeleGeante", "Epic", 3)
Inventory.StartPlacing(uid2)
local target2 = floorPoint(ada, 6, 20)
standNear(ada, target2)
aimAt(target2)
advance(0.2)
check(Inventory.GetState().Placing == uid2 and not ghostShown(), "mode pose sans carré")
UserInputServiceStub.TouchTap:Fire({ { X = MOUSE.X, Y = MOUSE.Y } }, false)
flush()
advance(0.6)
local model2 = floorItemOf(ada, uid2)
check(dataOf(ada).Items[uid2].Spot ~= nil and model2 and xzDistance(model2:GetPivot().Position, target2) < 0.05, "appui : posé au point touché")
check(not ghostShown(), "toujours aucun carré")

section("le serveur juge seul, quel que soit le point envoyé")
local uid3 = bringItem(ada, "Z3_Smartphone", "Rare", 3)
local function sendPoint(point)
	local before = #notifies(ada)
	fireAs(ada, "PlaceBox", uid3, point)
	flush()
	advance(0.4)
	local n = lastNotify(ada)
	return #notifies(ada) > before and n or nil
end
standNear(ada, floorPoint(ada, -6, 20))
local n1 = sendPoint(floorPoint(ada, -6, 60))
check(dataOf(ada).Items[uid3].Spot == nil and n1 and string.find(n1.args[1], "inside your own shop", 1, true) and n1.args[2] == "Warning", "point hors de sa boutique : refusé, Notify")
local n2 = sendPoint(floorPoint(ada, 20, -2)) -- dans la boutique, à plus de 12 studs du personnage
check(dataOf(ada).Items[uid3].Spot == nil and n2 and string.find(n2.args[1], "Get closer", 1, true) and n2.args[2] == "Warning", `point trop loin : refusé, Notify ({n2 and n2.args[1]})`)
standNear(ada, S.counter)
local n3 = sendPoint(S.counter) -- sous le comptoir (meuble solide)
check(dataOf(ada).Items[uid3].Spot == nil and n3 and n3.args[2] == "Warning", `point sur un meuble : refusé, Notify ({n3 and n3.args[1]})`)
local floorHere = floorPoint(ada, -6, 20)
standNear(ada, floorHere)
sendPoint(floorHere + Vector3.new(0, 25, 0)) -- point en l'air au-dessus du sol de sa boutique
local model3 = floorItemOf(ada, uid3)
check(dataOf(ada).Items[uid3].Spot ~= nil and model3 ~= nil, "point en l'air au-dessus de sa boutique : posé")
check(model3 and math.abs(model3:GetPivot().Position.Y - floorHere.Y) < 0.2 and xzDistance(model3:GetPivot().Position, floorHere) < 0.05, `le serveur le pose sur le sol, pas en l'air ({model3 and model3:GetPivot().Position})`)

summary("scénario place")
