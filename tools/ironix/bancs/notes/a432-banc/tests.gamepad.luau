--!nocheck
-- Scénario « gamepad » du banc a432 : à la manette (a419), la visée est le centre de l'écran, R2 (Config/Gamepad.Place)
-- pose l'objet sous antivol au point visé, sans carré au sol ; ButtonB (Config/Gamepad.Back) quitte le mode pose.
local ada, Inventory = a432Start()
local Pad = sharedModule("Config/Gamepad", "client")
A432_PAD = true

section("manette : R2 pose au point visé, sans carré")
check(Pad.Place == Enum.KeyCode.ButtonR2 and Pad.Back == Enum.KeyCode.ButtonB, "Config/Gamepad : Place = R2, Back = ButtonB")
local uid = bringItem(ada, "Z3_Smartphone", "Rare", 3)
Inventory.StartPlacing(uid)
local target = floorPoint(ada, 18, 20)
standNear(ada, target)
aimAt(target)
local rays = A432_VIEWPORT_RAYS or 0
advance(0.2)
check(Inventory.GetState().Placing == uid, "mode pose de l'objet")
check((A432_VIEWPORT_RAYS or 0) > rays, "visée au centre de l'écran (ViewportPointToRay)")
check(not ghostShown(), "aucun carré au sol")
check(Inventory.GetState().AimValid == true, "visée valable (AimValid)")
local calls = #serverCalls("PlaceBox")
pressKey("ButtonR2")
flush()
advance(0.6)
local model = floorItemOf(ada, uid)
check(#serverCalls("PlaceBox") == calls + 1, "R2 : PlaceBox envoyé")
check(dataOf(ada).Items[uid].Spot ~= nil and model and xzDistance(model:GetPivot().Position, target) < 0.05, "R2 : posé au point visé")
check(Inventory.GetState().Placing == nil and not ghostShown(), "posé : fin du mode pose, aucun carré")

section("manette : hors de sa boutique, refus compris")
local uid2 = bringItem(ada, "Z3_TeleGeante", "Epic", 3)
Inventory.StartPlacing(uid2)
aimAt(floorPoint(ada, 6, 60))
advance(0.2)
check(not ghostShown(), "aucun carré hors de sa boutique")
local told = #notifies(ada)
pressKey("ButtonR2")
flush()
advance(0.4)
local n = lastNotify(ada)
check(dataOf(ada).Items[uid2].Spot == nil and #notifies(ada) > told and n and n.args[2] == "Warning", `R2 hors de sa boutique : refusé, Notify « Warning » ({n and n.args[1]})`)
check(Inventory.GetState().Placing == uid2, "le mode reste")

section("manette : ButtonB quitte le mode pose")
pressKey("ButtonB")
advance(0.1)
check(Inventory.GetState().Placing == nil and not ghostShown(), "ButtonB : fin du mode pose")
check(dataOf(ada).Items[uid2].Spot == nil and dataOf(ada).Items[uid2].AntiTheft == true, "l'objet reste dans l'inventaire, sous antivol")

summary("scénario gamepad")
