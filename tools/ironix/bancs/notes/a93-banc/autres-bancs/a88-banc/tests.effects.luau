--!nocheck
-- Scénario « effects » (a88) : chaque effet et sa fin (Speed, Money, Strength, Invisibility), cumul de durée,
-- PotionTime, accroches d'avant gardées (AaBoostService ×3 pour Cy), mort, départ, crochet clear.
startPotions()
local ada = join("Ada", newProfile())
local bob = join("Bob", newProfile())
local cy = join("Cy", newProfile())
advance(1.2)

local function mod(player)
	local list = SPEED_MODIFIERS[player]
	return if list then list.Potion else nil
end
local function near(a, b, eps)
	return a ~= nil and b ~= nil and math.abs(a - b) <= (eps or 0.5)
end

section("Speed et cumul")
local t = serverNow()
test("Ada give Speed")
check(mod(ada) == 2, `modificateur de vitesse « Potion » = 2 (trouvé {mod(ada)})`)
check(near(attr(ada, "Speed"), t + 120), "Potion_Speed = heure serveur + 120 s")
local msg, kind = lastNotify(ada)
check(msg == "Speed ×2 for 2:00!" and kind == "Success", `message : « {msg} » ({kind})`)
advance(30, 0.25)
test("Ada give Speed")
check(near(attr(ada, "Speed"), t + 240), `même type : la durée s'ajoute (fin à +{attr(ada, "Speed") - t} s)`)
msg = lastNotify(ada)
check(msg == "Speed ×2 for 3:30!", `message du cumul : « {msg} »`)
check(mod(bob) == nil and bob:GetAttribute("Potion_Speed") == nil, "Bob : rien")
advance(240 - 30 - 1, 0.25)
check(mod(ada) == 2 and attr(ada, "Speed") ~= nil, "encore actif 1 s avant la fin")
advance(1.5, 0.25)
check(mod(ada) == nil and attr(ada, "Speed") == nil, "fini : modificateur retiré, attribut retiré")
check(not PotionService.IsActive(ada, "Speed"), "IsActive faux")

section("Money")
check(DisplayService.GetIncomeMultiplier(ada) == 1 and DisplayService.GetIncomeMultiplier(cy) == 3, "avant : Ada ×1, Cy ×3 (accroche d'avant)")
test("Ada give Money")
test("Cy give Money")
check(DisplayService.GetIncomeMultiplier(ada) == 2 and DisplayService.GetGlobalMultiplier(ada) == 2, "Ada : revenus ×2 (M global ×2)")
check(DisplayService.GetIncomeMultiplier(cy) == 6, `Cy : ×3 gardé, ×2 de la potion = ×6 (trouvé {DisplayService.GetIncomeMultiplier(cy)})`)
check(DisplayService.GetIncomeMultiplier(bob) == 1, "Bob : ×1")
msg = lastNotify(ada)
check(msg == "Money ×2 for 2:00!", `message : « {msg} »`)
advance(120.5, 0.25)
check(DisplayService.GetIncomeMultiplier(ada) == 1 and DisplayService.GetIncomeMultiplier(cy) == 3 and attr(ada, "Money") == nil, "fini : ×1 et ×3")

section("Strength")
local adaShop = shopOf(ada)
local S = refsOfShop(adaShop)
local id = windowIdOf(adaShop)
local function hitOnce(hitter)
	moveTo(hitter, S.outside + S.front * -3)
	local tool = giveTool(hitter)
	fireAs(hitter, "HitWindow", id)
	advance(0.15)
	tool:Destroy()
	local list = remotes("WindowHit", function(e)
		return e.args[1] == id and e.args[3] == hitter
	end)
	local e = list[#list]
	return if e then e.args[4] else nil
end
check(hitOnce(bob) == 10, "Bob sans potion : 10 par coup")
test("Bob give Strength")
advance(0.6)
check(hitOnce(bob) == 20, "Bob avec Strength : 20 par coup")
check(hitOnce(cy) == 30, "Cy sans potion : ×3 de l'accroche d'avant = 30")
test("Cy give Strength")
advance(0.6)
check(hitOnce(cy) == 60, "Cy avec Strength : ×3 × 2 = 60")
local bobDoor = shopOf(bob):FindFirstChild("Window", true)
check(bobDoor:GetAttribute("MaxHP") == 500, `PV de la vitrine de Bob inchangés (500, trouvé {bobDoor:GetAttribute("MaxHP")})`)
advance(120.5, 0.25)
check(hitOnce(bob) == 10 and bob:GetAttribute("Potion_Strength") == nil, "fini : 10 par coup")

section("Invisibility")
check(GuardStub.IsHiddenFromNight(ada) == false and GuardStub.IsHiddenFromNight(cy) == true, "avant : Ada visible, Cy caché par l'accroche d'avant")
test("Ada give Invisibility")
check(GuardStub.IsHiddenFromNight(ada) == true and GuardStub.IsHiddenFromNight(bob) == false, "Ada invisible pour les vigiles de nuit, Bob non")
msg = lastNotify(ada)
check(msg == "Invisibility for 1:00!", `message : « {msg} »`)
advance(60.5, 0.25)
check(GuardStub.IsHiddenFromNight(ada) == false and attr(ada, "Invisibility") == nil, "fini : de nouveau visible")

section("PotionTime")
skill(ada, "PotionTime", 1)
t = serverNow()
test("Ada give Money")
check(near(attr(ada, "Money"), t + 150), "niveau 1 : 120 × 1,25 = 150 s")
msg = lastNotify(ada)
check(msg == "Money ×2 for 2:30!", `message : « {msg} »`)
test("Ada clear")
skill(ada, "PotionTime", 2)
t = serverNow()
test("Ada give Invisibility")
check(near(attr(ada, "Invisibility"), t + 90), "niveau 2 : 60 × 1,5 = 90 s")
local uid, position = spawnNear(ada, "Strength")
moveTo(ada, position + Vector3.new(0, 3, 0))
t = serverNow()
pick(ada, uid)
check(near(attr(ada, "Strength"), t + 180), "ramassée au niveau 2 : 120 × 1,5 = 180 s")
test("Ada clear")

section("crochet clear")
local u1 = spawnNear(ada, "Speed")
local u2 = spawnNear(ada, "Money")
test("Ada give Speed")
local r = #removedTo(ada)
test("Ada clear")
local live = livePotions(ada)
check(live[u1] == nil and live[u2] == nil and #removedTo(ada) >= r + 2, "clear : PotionRemoved pour chaque potion")
check(attr(ada, "Speed") == nil and mod(ada) == nil, "clear : effets retirés")

section("mort")
local u3 = spawnNear(ada, "Speed")
test("Ada give Speed")
test("Ada give Money")
test("Ada give Invisibility")
kill(ada)
advance(0.1)
check(attr(ada, "Speed") == nil and attr(ada, "Money") == nil and attr(ada, "Invisibility") == nil, "mort : attributs retirés")
check(mod(ada) == nil and DisplayService.GetIncomeMultiplier(ada) == 1 and GuardStub.IsHiddenFromNight(ada) == false, "mort : vitesse, revenus et invisibilité normaux")
check(livePotions(ada)[u3] ~= nil, "mort : les potions posées restent")
spawnCharacter(ada, Vector3.new(0, 3, 0))
advance(0.5)
test("Ada give Speed")
kill(ada)
advance(0.1)
check(attr(ada, "Speed") == nil and mod(ada) == nil, "2e personnage : la mort retire aussi les effets")

section("départ")
test("Bob give Speed")
test("Bob give Money")
leave(bob)
advance(0.5)
check(mod(bob) == nil, "départ : modificateur de vitesse retiré")
check(not PotionService.IsActive(bob, "Money") and DisplayService.GetIncomeMultiplier(bob) == 1, "départ : plus d'effet")
check(not logHas("joueur introuvable", "WARN"), "crochet : tous les joueurs trouvés")
finish("scénario effects")
