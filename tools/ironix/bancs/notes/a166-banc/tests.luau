--!nocheck
-- Scénario du coffre hebdomadaire (a166, MAJ 1) : coupé (rien ne change), 4 jours puis 5, deux réclamations,
-- semaine qui change, et le client (WeeklyChest, Progress, Done, bouton, pastille).
advance(1000)
startServer()
days(10)
local ada = join("Ada", newProfile8(), 71)
advance(1.5)
buildUi(ada)
local W = buildWeekly()
startClient(ada)
advance(0.5)
local Controller = clientModule("RewardsController")

section("off")
check(ada:GetAttribute("RewardWeeklyDays") == nil and ada:GetAttribute("RewardWeeklyClaimed") == nil, "coupé : aucun attribut du coffre")
local keys = itemKeys(ada)
local n0 = #notifies(ada)
fireAs(ada, "ClaimWeekly"); flush()
check(#giftsSince(ada, keys) == 0 and #notifies(ada) == n0, "coupé : ClaimWeekly ignoré, rien donné, aucun message")
check(dataOf(ada).Rewards.Weekly.Days == 0, "coupé : aucun jour compté")
check(not W.chest.Visible, "coupé : WeeklyChest caché")
local s = stateOf(ada)
check(s.WeeklyOn == false and s.WeeklyDays == 0, "GetState : coffre coupé")

-- Aller au lundi suivant (coupé : rien de compté).
local day = RewardService.GetDay()
local toMonday = (7 - (day + 3) % 7) % 7
if toMonday == 0 then toMonday = 7 end
days(toMonday)
check((RewardService.GetDay() + 3) % 7 == 0, "lundi")
check(dataOf(ada).Rewards.Weekly.Days == 0, "toujours rien compté")

section("quatre")
weeklyOn(true)
check(ada:GetAttribute("RewardWeeklyDays") == 1 and ada:GetAttribute("RewardWeeklyClaimed") == false, `allumé : lundi compté ({ada:GetAttribute("RewardWeeklyDays")})`)
check(W.chest.Visible and W.progress.Text == "1/5", `WeeklyChest visible, « {W.progress.Text} »`)
advance(5)
check(ada:GetAttribute("RewardWeeklyDays") == 1, "même jour : compté une seule fois")
for _ = 1, 3 do days(1) end
check(ada:GetAttribute("RewardWeeklyDays") == 4, `jeudi : 4 jours ({ada:GetAttribute("RewardWeeklyDays")})`)
check(W.dones[4].Visible and not W.dones[5].Visible and W.label.Text == "LOCKED", "jauge à 4, bouton LOCKED")
check(not Controller.GetState().WeeklyReady, "client : pas prêt")
keys = itemKeys(ada)
claimWeekly(ada)
check(#giftsSince(ada, keys) == 0, "4 jours : rien donné")
check(#notifies(ada, "Play on 5 different days") == 1, "message WeeklyNotYet")
check(dataOf(ada).Rewards.Weekly.ClaimedWeek == 0, "rien noté")

section("cinq")
days(1)
check(ada:GetAttribute("RewardWeeklyDays") == 5, "vendredi : 5 jours")
check(UI.alert.Visible and Controller.GetState().WeeklyReady, "pastille RewardsAlert et client prêt")
check(W.label.Text == "OPEN" and W.dones[5].Visible and W.progress.Text == "5/5", `bouton au texte de Clément, « {W.progress.Text} »`)
claimDaily(ada) -- le jour du calendrier, pour que la pastille ne dépende que du coffre
local calls = #serverCalls("ClaimWeekly")
click(W.button)
advance(0.3)
check(#serverCalls("ClaimWeekly") == calls + 1, "WeeklyClaimButton : ClaimWeekly")
local gifts = giftsSince(ada, keys)
check(#gifts == 1, `un objet donné ({#gifts})`)
local def = gifts[1] and Items.ById[gifts[1].entry.Id]
check(def and (def.Zone or gifts[1].entry.Zone) >= 2, "objet de zone 2 au moins")
check(gifts[1] and #notifies(ada, giftText(gifts[1].entry)) == 1, "Notify de l'objet")
local ev = eventsOf(ada, "RewardClaim")
local last = ev[#ev]
check(last and last.fields[1] == "Source - Weekly" and string.sub(last.fields[2], 1, 10) == "Sku - Week", "télémétrie RewardClaim Source Weekly")
check(ada:GetAttribute("RewardWeeklyClaimed") == true and W.label.Text == "CLAIMED", "réclamé : attribut et CLAIMED")
check(not UI.alert.Visible, "pastille éteinte")

section("deux réclamations")
keys = itemKeys(ada)
claimWeekly(ada)
claimWeekly(ada)
check(#giftsSince(ada, keys) == 0, "2e et 3e réclamations : rien")
check(#notifies(ada, "Weekly chest already opened") == 2, "message WeeklyAlreadyClaimed")
days(2)
check(ada:GetAttribute("RewardWeeklyDays") == 6 and ada:GetAttribute("RewardWeeklyClaimed") == true, "dimanche (samedi sauté par l horloge) : 6 jours, toujours réclamé")
claimWeekly(ada)
check(#giftsSince(ada, keys) == 0, "dimanche : rien")

section("semaine suivante")
days(1)
check(ada:GetAttribute("RewardWeeklyDays") == 1 and ada:GetAttribute("RewardWeeklyClaimed") == false, "lundi : remise à zéro, 1 jour, pas réclamé")
check(W.label.Text == "LOCKED" and not W.dones[2].Visible, "client : jauge remise à zéro")
local ends = ada:GetAttribute("RewardWeekEndsAt")
check(type(ends) == "number" and ends - serverTime() > 6 * DAY and ends - serverTime() <= 7 * DAY, "RewardWeekEndsAt : prochain lundi")
days(2) -- mercredi, mardi sauté par l horloge (absent ce jour-là)
check(ada:GetAttribute("RewardWeeklyDays") == 2, `jour sauté par l'horloge : 2 jours comptés ({ada:GetAttribute("RewardWeeklyDays")})`)

section("hors ligne et retour")
leave(ada)
advance(1)
days(1)
local ada2 = join("Ada", nil, 71)
advance(1.5)
check(ada2:GetAttribute("RewardWeeklyDays") == 3, `retour jeudi : 3 jours ({ada2:GetAttribute("RewardWeeklyDays")})`)

section("recoupé")
weeklyOn(false)
check(ada2:GetAttribute("RewardWeeklyDays") == nil, "recoupé : attributs retirés")
summary("scénario coffre")
