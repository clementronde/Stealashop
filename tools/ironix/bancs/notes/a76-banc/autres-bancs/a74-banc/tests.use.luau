--!nocheck
-- Scénario « use » (L-095 point 6, ligne 24) : touches 1 à 6 (une seule écoute, celle
-- d'InventoryController, passée à la barre par SetSlotKeys : une touche = une action), clic sur une case :
-- outil et batte en main ou rangés, Equipped sur la case tenue ; à l'arrivée en main, son UI_Equip, message
-- vert « <outil> equipped! » (NotifyController.Show, catégorie Success) et sursaut T.33 ; colis : mode pose,
-- puis rangé par la même case ; objet : PlaceItemAuto ; touche sans case : rien ; appui (T.31-32) et survol
-- (T.34 HoverCard) ; rien pendant un portage.

advance(1000)
startServer()
local data = newProfile()
addItem(data, "high", "Z3_Smartphone", nil, 3, 2)
local ada = join("Ada", data)
advance(1.5)
buildInventoryUi(ada)
buildHotbarUi(ada)
startClient(ada)
advance(0.5)
useSounds()
local Hotbar = clientModule("HotbarController")
local Inventory = clientModule("InventoryController")
local UiMotion = sharedModule("Config/UiMotion")
local function held()
	return ada.Character:FindFirstChildWhichIsA("Tool")
end
local premium = bringBox(ada, "Rare", "Z3_Smartphone", "Premium", 3)
advance(0.3)
-- Copie a76 (vague 25) : le colis arrivé prend la 1re case vide (4), après l'objet (3).
check(slotOrder() == `Slot_Tool,Slot_Bat,Slot_Item_high,Slot_Box_{premium},Slot_Empty_5,Slot_Empty_6`, `cases : {slotOrder()}`)
local slots = slotsOf()

section("touche 1 : l'outil de casse, une seule fois")
local notified = #NOTIFIED
local tweens = #TWEENS
pressKey("One")
advance(0.05)
check(held() and held():GetAttribute("ToolId") == "Fists", "1 : les poings en main (pas mis puis rangés par deux écoutes)")
check(slotPart(slots.Slot_Tool, "Equipped").Visible and not slotPart(slots.Slot_Bat, "Equipped").Visible, "Equipped sur la case de l'outil")
check(#NOTIFIED == notified + 1 and lastNotify().message == "Fists equipped!" and lastNotify().kind == "Success", `message vert « {lastNotify() and lastNotify().message} » ({lastNotify() and lastNotify().kind})`)
check(table.find(SOUNDS, "UI_Equip") ~= nil, "son UI_Equip")
local pops = popsOn(slots.Slot_Tool, tweens)
check(#pops == 1 and pops[1] == UiMotion.Success.From, `sursaut de réussite sur la case (T.33 : × {pops[1]} → 1)`)
pressKey("One")
advance(0.05)
check(held() == nil and not slotPart(slots.Slot_Tool, "Equipped").Visible, "1 encore : rangé, Equipped caché")
check(#NOTIFIED == notified + 1, "ranger ne dit rien")

section("touche 2 et clic : la batte")
pressKey("Two")
advance(0.05)
check(held() and held():GetAttribute("BatTool") == true and slotPart(slots.Slot_Bat, "Equipped").Visible, "2 : la batte en main, Equipped sur sa case")
check(lastNotify().message == "Bat equipped!", "« Bat equipped! »")
click(slots.Slot_Bat)
advance(0.05)
check(held() == nil and not slotPart(slots.Slot_Bat, "Equipped").Visible, "clic sur la case de la batte tenue : rangée")
click(slots.Slot_Tool)
advance(0.05)
check(held() and held():GetAttribute("ToolId") == "Fists", "clic sur la case de l'outil : en main")
pressKey("Two")
advance(0.05)
check(held() and held():GetAttribute("BatTool") == true and not slotPart(slots.Slot_Tool, "Equipped").Visible, "2 avec l'outil en main : la batte le remplace, Equipped suit")
pressKey("Two")
advance(0.05)

section("touche 4 : le colis en mode pose, puis rangé")
pressKey("Four")
advance(0.05)
check(Inventory.GetState().Placing == premium and slotPart(slots["Slot_Box_" .. premium], "Equipped").Visible, "4 : mode pose de ce colis, Equipped sur sa case")
pressKey("Four")
advance(0.05)
check(Inventory.GetState().Placing == nil and not slotPart(slots["Slot_Box_" .. premium], "Equipped").Visible, "4 encore : fin du mode pose")
click(slots["Slot_Box_" .. premium])
advance(0.05)
check(Inventory.GetState().Placing == premium, "clic sur la case du colis : mode pose")
pressKey("One")
advance(0.05)
check(Inventory.GetState().Placing == nil and held() and held():GetAttribute("ToolId") == "Fists", "1 pendant la pose : outil en main, fin du mode pose")
pressKey("One")
advance(0.05)

section("touche 3 : l'objet sur un présentoir libre")
local sent = #serverCalls("PlaceItemAuto")
pressKey("Three")
advance(0.5)
check(#serverCalls("PlaceItemAuto") == sent + 1 and serverCalls("PlaceItemAuto")[sent + 1].args[1] == "high", "PlaceItemAuto(\"high\")")
check(dataOf(ada).Display and invItem(ada, "high") and invItem(ada, "high").Slot ~= nil, "le serveur l'expose")
check(slotsOf().Slot_Item_high == nil and slotOrder() == `Slot_Tool,Slot_Bat,Slot_Empty_3,Slot_Box_{premium},Slot_Empty_5,Slot_Empty_6`, `objet exposé : sa case est vide, rien ne bouge : {slotOrder()}`)

section("touches sans case")
sent = #serverCalls("PlaceItemAuto")
pressKey("Five")
pressKey("Seven")
advance(0.1)
check(held() == nil and Inventory.GetState().Placing == nil and #serverCalls("PlaceItemAuto") == sent, "5 (pas de case) et 7 (au-delà de 6) : rien")
pressKey("One", true)
check(held() == nil, "touche traitée par l'UI (chat) : rien")
ada:SetAttribute("Carrying", "Rare")
pressKey("One")
click(slots.Slot_Bat)
advance(0.05)
check(held() == nil, "pendant un portage : rien en main")
ada:SetAttribute("Carrying", nil)

section("appui, survol")
local slot = slotsOf().Slot_Bat
local before = #TWEENS
slot.MouseButton1Down:Fire()
local presses = popsOn(slot, before)
check(#presses == 1 and presses[1] == UiMotion.Press.To, `appui : la case passe à × {presses[1]} puis revient (T.31-32)`)
before = #TWEENS
slot.InputBegan:Fire({ UserInputType = Enum.UserInputType.Touch })
check(#popsOn(slot, before) == 1, "appui au doigt : le même sursaut")
advance(1)
check(slot:FindFirstChild(UiMotion.PopScaleName) == nil, "revenue à 1 : UIScale retiré")
slot.MouseEnter:Fire()
check(slotPart(slot, "HoverOutline").Visible, "survol : HoverOutline visible (T.34 HoverCard)")
slot.MouseLeave:Fire()
advance(0.5)
check(not slotPart(slot, "HoverOutline").Visible, "sortie : caché")
check(Hotbar.GetState().Slots[2].Key == "Bat", "GetState : cases dans l'ordre")

summary("scénario use")
