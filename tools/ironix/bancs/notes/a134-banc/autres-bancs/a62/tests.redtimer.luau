---------------------------------------------------------------- scénario « redtimer » (L-092 3c) : HeistTimer rouge sous 3 s
local T = UiMotionC.TimerTick
local Motion = requireModule(MOTION_MODULE, "client")
Motion.SetSoundPlayer(function() end)
P1:SetAttribute("Cash", 100)
P1:SetAttribute("Income", 1)
local hud = makeHud()
local timer = el(hud, "HeistTimer")
local white = Color3.new(1, 1, 1)
timer.TextColor3 = white
local Heist = requireModule(HEIST_MODULE, "client")
local Hud = requireModule(HUD_MODULE, "client")
taskLib.spawn(Hud.Start)
step(0.1)
local RED = Color3.fromHex("E8413C")

print("\n== R1. Le chiffre passe au rouge à 3 s, puis reprend sa couleur")
check(sameColor(T.RedColor, RED) and T.RedBelow == 3, "R1a Config : #E8413C, à 3 s ou moins")
Heist.Emit("Z1_Store", Workspace:GetServerTimeNow() + 5.5)
step(1 / 30)
check(timer.Text == "HEIST: 6s" and sameColor(timer.TextColor3, white), `R1b 6 s : couleur d'origine ({timer.Text})`)
step(2.6)
check(timer.Text == "HEIST: 3s" and sameColor(timer.TextColor3, RED), `R1c 3 s : rouge ({timer.Text})`)
step(1)
check(timer.Text == "HEIST: 2s" and sameColor(timer.TextColor3, RED), "R1d 2 s : toujours rouge")
step(3)
check(timer.Visible == false and sameColor(timer.TextColor3, white), "R1e vol fini : couleur d'origine")

print("\n== R2. Chrono remonté")
local t0 = Workspace:GetServerTimeNow()
Heist.Emit("Z2_Store", t0 + 2.5)
step(1 / 30)
check(sameColor(timer.TextColor3, RED), "R2a 3 s : rouge")
Heist.Emit("Z3_Store", t0 + 8)
step(0.1)
check(timer.Text == "HEIST: 8s" and sameColor(timer.TextColor3, white), `R2b un autre vol plus long : couleur d'origine ({timer.Text})`)
step(9)
check(timer.Visible == false and sameColor(timer.TextColor3, white), "R2c fini : couleur d'origine")
summary()
