---------------------------------------------------------------- scénarios (sans CosmeticService)
print("\n== N. Sans CosmeticService (module absent de Services)")
check(logCount("[ShopService] CosmeticService absent : achats d'auras et de trails refusés", "WARN") == 1, "N1 un avertissement en Studio au démarrage, pas d'erreur")
at(ROOT2, AURA_SPOT)
setCash(P2, 1000)
local m = mark()
send(P2, "BuyItem", "Spark")
local n = onlyNotify(P2, m)
check(n and n.text == "This item isn't available yet." and n.kind == "Warning" and cash(P2) == 1000, "N2 achat d'aura refusé : Notify « This item isn't available yet. », rien de débité")
send(P2, "BuyItem", "Dust")
check(cash(P2) == 1000, "N3 achat de trail refusé")
at(ROOT2, SHOP_SPOT)
send(P2, "BuyItem", "Wrench")
check(cash(P2) == 700 and owned(P2, "Wrench") and P2:GetAttribute("EquippedTool") == "Wrench", "N4 la boutique d'armes marche")
at(ROOT2, PLOT2_SPOT)
send(P2, "BuyItem", "Treadmill")
check(cash(P2) == 550 and P2:GetAttribute("TreadmillLevel") == 1, "N5 les améliorations marchent")
check(logCount("CosmeticService", "WARN") == 1, "N6 un seul avertissement en tout, même après des achats refusés")
check(FAILS == 0, "N7 aucune erreur dans une tâche")
summary()
