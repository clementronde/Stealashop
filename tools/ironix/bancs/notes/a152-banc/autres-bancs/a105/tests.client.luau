--!nocheck
-- Scénario « client » (exigence 4 de la vague 31) : vrais InventoryController et UnboxController. Objet sous
-- antivol de l'inventaire : PlaceItem (barre du bas, carte) lance le mode pose, clic → PlaceBox(itemUid, point).
-- Au sol : copie de BB_AntiTheft (ItemName à la couleur de la rareté, TimeLabel m:ss puis « UNLOCKED! » en vert),
-- invite « Display » du propriétaire une fois débloqué → OpenBox(itemUid) ; chez un autre, « Steal » pendant
-- l'antivol, boutique ouverte au vol → StealFloorItem(plotIndex, itemUid) au début et à la fin du maintien.

advance(1000)
-- BB_AntiTheft de Clément (relevé Studio du 2026-11-12) : ItemName, TimeLabel.
do
	local uiFolder = ASSETS:FindFirstChild("UI") or folder(ASSETS, "UI")
	local bb = make("BillboardGui", { Name = "BB_AntiTheft", MaxDistance = 10, AlwaysOnTop = false }, uiFolder)
	make("TextLabel", { Name = "ItemName", Text = "Giant TV", TextColor3 = Color3.new(1, 1, 1) }, bb)
	make("TextLabel", { Name = "TimeLabel", Text = "0:10", TextColor3 = Color3.new(1, 1, 1) }, bb)
end
startServer()
local ada = join("Ada", nil)
local bob = join("Bob", nil)
advance(1.5)
startClient(ada)
advance(0.5)
local Inventory = clientModule("InventoryController")
local Unbox = clientModule("UnboxController")

section("démarrage")
check(not logHas("[Loader", "WARN"), "aucun module en échec au chargement")

section("objet sous antivol de l'inventaire : PlaceItem lance le mode pose")
local uid = bringItem(ada, "Z3_TeleGeante", "Epic", 3, { Size = "Big" })
advance(0.6)
local calls = #serverCalls("PlaceItemAuto")
Inventory.PlaceItem(uid)
advance(0.1)
check(Inventory.GetState().Placing == uid, "mode pose de l'objet (comme un colis)")
check(#serverCalls("PlaceItemAuto") == calls, "pas de PlaceItemAuto")
local target = floorPoint(ada, 6, 0)
standNear(ada, target)
aimAt(target)
advance(0.1)
local pcalls = #serverCalls("PlaceBox")
worldClick()
flush()
check(#serverCalls("PlaceBox") == pcalls + 1 and serverCalls("PlaceBox")[pcalls + 1].args[1] == uid, "clic : PlaceBox(itemUid, point)")
advance(0.6)
check(dataOf(ada).Items[uid].Spot ~= nil, "le serveur a posé l'objet")
check(Inventory.GetState().Placing == nil, "fin du mode pose")

section("BB_AntiTheft et invite du propriétaire")
local model = floorItemOf(ada, uid)
local view = model and Unbox.GetFloorView(model)
check(view ~= nil, "vue de l'objet au sol")
check(view and view.ItemText == "Big Giant TV", `ItemName = nom avec la mutation ({view and view.ItemText})`)
local gui = model and model:FindFirstChild("BB_AntiTheft", true)
local nameLabel = gui and gui:FindFirstChild("ItemName")
check(nameLabel and nameLabel.TextColor3 == Rarities.ById.Epic.Color, "ItemName à la couleur de la rareté (Épique)")
check(view and view.TimeText == string.format("0:%02d", antiTheftOf("Epic")), `TimeLabel = le temps restant ({view and view.TimeText})`)
check(view and view.OwnerPrompt == false and view.StealPrompt == nil, "invite « Display » cachée pendant l'antivol, pas d'invite de vol chez soi")
advance(10)
view = Unbox.GetFloorView(model)
check(view and view.TimeText == string.format("0:%02d", antiTheftOf("Epic") - 10), `le minuteur descend ({view and view.TimeText})`)
advance(antiTheftOf("Epic"))
view = Unbox.GetFloorView(model)
check(view and view.TimeText == "UNLOCKED!", "« UNLOCKED! »")
local timeLabel = gui and gui:FindFirstChild("TimeLabel")
check(timeLabel and timeLabel.TextColor3 == Color3.fromHex("5cff4a"), "en vert (5cff4a)")
check(view and view.OwnerPrompt == true, "invite « Display » montrée")
local prompt = model:FindFirstChild("UnboxPrompt", true)
check(prompt and prompt.ActionText == "Take", "ActionText « Take » (vague 44, a152 ; « Display » avant)")
local opens = #serverCalls("OpenBox")
standNear(ada, model:GetPivot().Position)
prompt.Triggered:Fire()
flush()
check(#serverCalls("OpenBox") == opens + 1 and serverCalls("OpenBox")[opens + 1].args[1] == uid, "déclenchée : OpenBox(itemUid)")
advance(0.3)
check(dataOf(ada).Items[uid].AntiTheft == nil and Unbox.GetFloorView(model) == nil, "repris par le serveur, vue retirée")

section("objet d'un autre : invite « Steal » pendant l'antivol, boutique ouverte")
local ub = bringItem(bob, "Z3_Smartphone", "Rare", 3)
placeItemAt(bob, ub, 6, 0)
local bobModel = floorItemOf(bob, ub)
local bobView = bobModel and Unbox.GetFloorView(bobModel)
check(bobView and bobView.OwnerPrompt == nil and bobView.StealPrompt == false, "invite « Steal » cachée (porte intacte)")
breakDoor(bob, ada)
advance(0.2)
bobView = Unbox.GetFloorView(bobModel)
check(bobView and bobView.StealPrompt == true, "porte cassée : « Steal » montrée")
local steal = bobModel:FindFirstChild("StealFloorPrompt", true)
check(steal and steal.ActionText == "Steal" and steal.HoldDuration == sharedModule("Config/PvP").StealGrabTime, "maintien PvP.StealGrabTime")
local sc = #serverCalls("StealFloorItem")
steal.PromptButtonHoldBegan:Fire()
steal.Triggered:Fire()
flush()
local sCalls = serverCalls("StealFloorItem")
check(#sCalls == sc + 2 and sCalls[sc + 1].args[1] == shopOf(bob):GetAttribute("PlotIndex") and sCalls[sc + 1].args[2] == ub, "StealFloorItem(plotIndex, itemUid) au début et à la fin")

summary("scénario client")
