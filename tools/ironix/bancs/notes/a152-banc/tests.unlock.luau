--!nocheck
-- Scénario « unlock » du banc a152 (point 2) : fin de l'antivol (« UNLOCKED! »), invite « Take » du propriétaire ;
-- l'objet va dans sa main s'il a les mains libres, sinon dans la barre du bas ou l'inventaire ; jamais posé tout
-- seul sur un présentoir (des présentoirs libres tout du long).
advance(1000)
startServer()
local ada = join("Ada", nil)
advance(1.5)
buildInventoryUi(ada)
buildHotbarUi(ada)
startClient(ada)
advance(0.5)
local Unbox = clientModule("UnboxController")
local Held = serverModule("HeldItemService")

section("mains libres : en main")
local uid = bringItem(ada, "Z3_TeleGeante", "Epic", 3)
local entry = placeItemAt(ada, uid, 6, 0)
check(entry and entry.Spot ~= nil, "objet posé au sol, antivol en cours")
check(DisplayService.HasRoom(ada) and countKeys(dataOf(ada).Display) == 0, "présentoirs libres, rien d'exposé")
advance(antiTheftOf("Epic") + 1)
local model = floorItemOf(ada, uid)
local view = model and Unbox.GetFloorView(model)
check(view and view.OwnerPrompt == true, "« UNLOCKED! » : invite du propriétaire montrée")
local prompt = model and model:FindFirstChild("UnboxPrompt", true)
check(prompt and prompt.ActionText == "Take", `ActionText « Take » ({prompt and prompt.ActionText})`)
check(ada.Character:FindFirstChildOfClass("Tool") == nil, "rien en main")
standNear(ada, model:GetPivot().Position)
trigger(prompt)
advance(0.3)
local item = dataOf(ada).Items[uid]
check(item and item.AntiTheft == nil and item.Spot == nil, "antivol retiré, plus au sol")
check(displayedAt(ada, uid) == nil and countKeys(dataOf(ada).Display) == 0, "pas posé sur un présentoir")
check(heldTool(ada) and heldTool(ada):GetAttribute("HeldItemUid") == uid and Held.GetHeld(ada) == uid, "dans sa main")
check(#notifies(ada, "is in your hand") == 1, "Notify « Giant TV is in your hand… »")
advance(0.5)
check(hotbarHas(uid), "et sa case dans la barre du bas")

section("mains prises (outil de casse) : barre du bas, pas en main")
local uid2 = bringItem(ada, "Z3_Smartphone", "Rare", 3)
check(#itemTools(ada) == 0, "l'objet tenu a été rangé au portage")
local entry2 = placeItemAt(ada, uid2, -6, 0)
check(entry2 and entry2.Spot ~= nil, "second objet posé au sol")
advance(antiTheftOf("Rare") + 1)
click(slotsOf().Slot_Tool)
flush()
advance(0.1)
local inHand = ada.Character:FindFirstChildWhichIsA("Tool")
check(inHand and inHand:GetAttribute("ToolId") ~= nil, "outil de casse en main")
local model2 = floorItemOf(ada, uid2)
standNear(ada, model2:GetPivot().Position)
advance(0.3)
fireAs(ada, "OpenBox", uid2)
flush()
advance(0.5)
local item2 = dataOf(ada).Items[uid2]
check(item2 and item2.AntiTheft == nil and item2.Spot == nil, "repris")
check(displayedAt(ada, uid2) == nil and countKeys(dataOf(ada).Display) == 0, "pas posé sur un présentoir")
check(#itemTools(ada) == 0 and ada.Character:FindFirstChildWhichIsA("Tool") == inHand, "l'outil de casse reste en main")
check(invItem(ada, uid2) and invItem(ada, uid2).Slot == nil, "dans l'inventaire")
check(hotbarHas(uid2), `case libre de la barre du bas ({slotOrder()})`)
check(#notifies(ada, "is in your inventory") == 1, "Notify « Smartphone is in your inventory. »")

summary("scénario unlock")
