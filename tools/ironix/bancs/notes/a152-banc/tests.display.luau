--!nocheck
-- Scénario « display » du banc a152 (point 3) : avec un objet en main, invite « Display » sur chaque présentoir
-- libre de SA boutique (PlaceItem) ; cachée sans objet en main, sur un présentoir pris ou verrouillé, avec un
-- objet sous antivol, pendant un portage ; refus du serveur hors de sa boutique ; le bouton « Display » de l'écran marche.
advance(1000)
startServer()
local data = newProfile()
addItem(data, "a", "Z1_Banane", nil, 1, 1)
addItem(data, "b", "Z3_Smartphone", nil, 3, 2)
addItem(data, "c", "Z1_Banane", nil, 1, 3)
addItem(data, "x", "Z1_Banane", 1, 1, 4)
data.Items.locked = { Id = "Z3_TeleGeante", Source = "NPC", At = 5, Zone = 3, AntiTheft = true }
local ada = join("Ada", data)
local bob = join("Bob", newProfile())
advance(1.5)
buildInventoryUi(ada)
buildHotbarUi(ada)
startClient(ada)
advance(1)
local Display = clientModule("DisplayController")
local Inventory = clientModule("InventoryController")

section("sans objet en main : invites cachées")
local prompts = Display.GetOwnerPrompts()
local count = 0
for _ in prompts.Display do
	count += 1
end
check(count == 24, `une invite par présentoir de sa boutique ({count}, 20 + 4 bonus)`)
check(prompts.Display[2] == false and prompts.Display[3] == false, "cachées sans objet en main")
local p2 = slotPromptOf(ada, 2)
check(p2 and p2.ActionText == "Display" and p2.HoldDuration == 0 and p2.MaxActivationDistance == Unbox.PromptDistance, "ActionText « Display », sans maintien, portée Unbox.PromptDistance")
local bobPlot = shopOf(bob)
local bobSlot = bobPlot:FindFirstChild("DisplaySlot_02", true)
check(bobSlot and bobSlot:FindFirstChild("DisplayHeldPrompt") == nil, "aucune invite dans la boutique de Bob")

section("objet en main : présentoirs libres seulement")
holdAs(ada, "a")
advance(0.3)
prompts = Display.GetOwnerPrompts()
check(heldTool(ada) ~= nil, "objet « a » en main")
check(prompts.Display[2] and prompts.Display[3] and prompts.Display[4], "allumée sur les présentoirs libres 2 à 4")
check(prompts.Display[1] == false, "cachée sur le présentoir 1 (pris)")
check(prompts.Display[5] == false and prompts.Display[21] == false, "cachée sur les présentoirs verrouillés")
check(slotPromptOf(ada, 3).ObjectText == "Banana", `ObjectText = l'objet tenu ({slotPromptOf(ada, 3).ObjectText})`)
standBySlot(ada, 3)
advance(0.3)
trigger(slotPromptOf(ada, 3))
advance(0.3)
check(displayedAt(ada, "a") == 3, "posé sur le présentoir 3 (PlaceItem)")
check(#itemTools(ada) == 0 and ada:GetAttribute("HeldItem") == nil, "plus en main")
advance(0.3)
prompts = Display.GetOwnerPrompts()
check(prompts.Display[3] == false and prompts.Display[2] == false, "plus rien en main : invites cachées")
check(prompts.Take.a == true, "« Take » sur l'objet posé")

section("hors de sa boutique : refusé (NotOnPlot)")
holdAs(ada, "b")
moveTo(ada, refsOfShop(shopOf(ada)).center + Vector3.new(0, 0, 60))
advance(0.3)
check(Display.GetOwnerPrompts().Display[2] == true, "invite allumée (le serveur décide de la portée)")
trigger(slotPromptOf(ada, 2))
check(displayedAt(ada, "b") == nil and heldTool(ada) ~= nil, "pas posé, toujours en main")
check(logHas("PlaceItem(b, 2) refusé : NotOnPlot"), "une ligne en Studio")
check(#notifies(ada, "Go back to your shop") == 1, "Notify « Go back to your shop to display an item. »")
standBySlot(ada, 2)
advance(0.3)
trigger(slotPromptOf(ada, 2))
check(displayedAt(ada, "b") == 2, "à portée : posé sur le présentoir 2")

section("objet sous antivol en main, portage : cachées")
holdAs(ada, "locked")
advance(0.3)
check(heldTool(ada) ~= nil and Display.GetOwnerPrompts().Display[4] == false, "objet sous antivol en main : cachée")
holdAs(ada, "c")
advance(0.3)
check(Display.GetOwnerPrompts().Display[4] == true, "objet libre en main : allumée")
ada:SetAttribute("Carrying", "NPCItem")
advance(0.3)
prompts = Display.GetOwnerPrompts()
check(prompts.Display[4] == false and prompts.Take.a == false, "portage : « Display » et « Take » cachées")
ada:SetAttribute("Carrying", nil)
advance(0.3)
check(Display.GetOwnerPrompts().Take.a == true, "fin du portage : « Take » revient")

section("le bouton Display de l'écran marche toujours")
advance(0.3)
Inventory.PlaceItem("c")
flush()
advance(0.3)
check(displayedAt(ada, "c") ~= nil, "PlaceItemAuto : « c » posé sur un présentoir libre")

summary("scénario display")
