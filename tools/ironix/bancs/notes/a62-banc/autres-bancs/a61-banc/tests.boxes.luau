--!nocheck
-- Scénario « boxes » (L-079, L-089 point 2) : une carte par colis, dans l'inventaire puis posés au sol :
-- icône ICON_BOX_<Tier> (l'image du Template si elle n'est pas livrée), « PREMIUM BOX », rareté et sa
-- couleur ; colis de l'inventaire : PlaceButton ; posé : « ON FLOOR », minuteur m:ss tant qu'il attend
-- (heure serveur), puis READY. PlaceButton → l'écran se ferme, mode pose (aperçu fantôme, clic sur le
-- sol de sa boutique → PlaceBox) ; refus du serveur : le mode reste ; posé : fin du mode ; Q, l'écran
-- rouvert, un outil pris en main : fin du mode ; jamais de Tool de colis.

advance(1000)
startServer()
local ada = join("Ada", nil)
advance(1.5)
buildInventoryUi(ada)
startClient(ada)
advance(0.5)
local Inventory = clientModule("InventoryController")
local premium = bringBox(ada, "Rare", "Z3_Smartphone", "Premium", 3)
local standard = bringBox(ada, "Common", "Z1_Banane", "Standard", 1)
local waiting = bringBox(ada, "Epic", "Z3_PcGamer", "Luxe", 3)
placeAt(ada, waiting, 6, 20)
local ready = bringBox(ada, "Common", "Z1_Donut", "Standard", 1)
placeAt(ada, ready, 12, 20)
advance(Rarities.ById.Common.OpenDelay + 0.5)
check(premium and standard and waiting and ready and dataOf(ada).Boxes[waiting].Spot and dataOf(ada).Boxes[ready].Spot, "4 colis : 2 dans l'inventaire, 2 posés")
check(countKeys(toolsOf(ada)) == 0, "aucun Tool de colis")
click(INV.invButton)
click(INV.tabs.Boxes.button)

section("cartes des colis")
local cards, n = cardsOf("Boxes")
check(n == 4 and countLabel("Boxes") == "4", `4 cartes, CountLabel « 4 » ({n})`)
local p, s, w, r = cards["Box_" .. premium], cards["Box_" .. standard], cards["Box_" .. waiting], cards["Box_" .. ready]
check(p and s and w and r, "Box_<uid> pour chacun")
check(p.LayoutOrder < s.LayoutOrder and s.LayoutOrder < w.LayoutOrder, "ceux de l'inventaire d'abord (les plus anciens d'abord), puis les posés")
check(cardPart(p, "BoxName").Text == "PREMIUM BOX" and cardPart(s, "BoxName").Text == "STANDARD BOX" and cardPart(w, "BoxName").Text == "LUXE BOX", "BoxName « PREMIUM BOX »…")
check(cardPart(p, "Icon").Image == "rbxassetid://9100" and cardPart(s, "Icon").Image == TEMPLATE_IMAGE.Boxes, "ICON_BOX_Premium ; ICON_BOX_Standard pas livrée : l'image du Template")
check(cardPart(p, "RarityBar.Rarity").Text == "RARE" and cardPart(p, "Rays").ImageColor3 == Rarities.ById.Rare.Color and cardPart(w, "Glow").ImageColor3 == Rarities.ById.Epic.Color, "rareté et sa couleur")
check(shown(cardPart(p, "PlaceButton")) and not shown(cardPart(p, "PlacedPill")) and not shown(cardPart(p, "TimerPill")) and not shown(cardPart(p, "ReadyPill")), "dans l'inventaire : PlaceButton seul")
check(not shown(cardPart(w, "PlaceButton")) and shown(cardPart(w, "PlacedPill")) and shown(cardPart(w, "TimerPill")) and not shown(cardPart(w, "ReadyPill")), "posé, en attente : ON FLOOR et minuteur")
local remaining = dataOf(ada).Boxes[waiting].ReadyAt - serverTime()
local whole = math.ceil(remaining)
check(cardPart(w, "TimerLabel").Text == string.format("%d:%02d", whole // 60, whole % 60), `minuteur m:ss ({cardPart(w, "TimerLabel").Text}, {remaining} s)`)
check(not shown(cardPart(r, "PlaceButton")) and shown(cardPart(r, "PlacedPill")) and not shown(cardPart(r, "TimerPill")) and shown(cardPart(r, "ReadyPill")), "posé et prêt : ON FLOOR et READY")
check(not string.find(ada:GetAttribute("InventoryState"), "Smartphone", 1, true) and not string.find(ada:GetAttribute("InventoryState"), "PcGamer", 1, true), "l'objet d'un colis n'est jamais dans l'état (5.7)")

section("le minuteur avance, puis READY")
local before = cardPart(w, "TimerLabel").Text
advance(2)
check(cardPart(w, "TimerLabel").Text ~= before, `il avance ({before} → {cardPart(w, "TimerLabel").Text})`)
advance(remaining)
check(not shown(cardPart(w, "TimerPill")) and shown(cardPart(w, "ReadyPill")), "attente finie : READY")

section("PlaceButton : l'écran se ferme, mode pose")
local hum = ada.Character:FindFirstChildOfClass("Humanoid")
hum:EquipTool(ada:FindFirstChild("Backpack"):FindFirstChildWhichIsA("Tool"))
flush()
check(ada.Character:FindFirstChildWhichIsA("Tool") ~= nil, "un outil en main avant")
click(cardPart(p, "PlaceButton"))
check(not INV.screen.Enabled and not Inventory.GetState().Open, "l'écran se ferme pendant la pose")
check(Inventory.GetState().Placing == premium, "mode pose du colis Premium")
check(ada.Character:FindFirstChildWhichIsA("Tool") == nil, "l'outil tenu est rangé (un clic ne frappe pas)")
local far = floorPoint(ada, 6, 60) -- hors de sa boutique
aimAt(far)
advance(0.1)
local ghost = Workspace:FindFirstChild("BoxGhost")
check(ghost ~= nil and ghost.Color == Color3.fromHex("#E8413C"), "aperçu rouge hors de sa boutique")
local calls = #serverCalls("PlaceBox")
worldClick()
flush()
advance(0.3)
check(#serverCalls("PlaceBox") == calls + 1 and dataOf(ada).Boxes[premium].Spot == nil, "clic hors de sa boutique : PlaceBox envoyé, refusé par le serveur")
check(#notifies(ada, "inside your own shop") + #notifies(ada, "floor of your shop") + #notifies(ada, "Get closer") >= 1, "refus : un Notify")
check(Inventory.GetState().Placing == premium, "refusé : le mode reste, pour réessayer")
local target = floorPoint(ada, 18, 20)
standNear(ada, target)
aimAt(target)
advance(0.1)
check(Workspace:FindFirstChild("BoxGhost").Color == Color3.fromHex("#35C93B"), "aperçu vert dans sa boutique")
worldClick()
flush()
advance(0.6)
local placedBox = dataOf(ada).Boxes[premium]
check(placedBox.Spot ~= nil and (UnboxService.GetBoxPosition(ada, premium) - target).Magnitude < 0.05, "posé au point visé")
check(Inventory.GetState().Placing == nil and (Workspace:FindFirstChild("BoxGhost") == nil or Workspace:FindFirstChild("BoxGhost").Parent == nil), "posé : fin du mode pose")
click(INV.invButton)
check(Inventory.GetState().Tab == "Boxes" and shown(cardPart(cardsOf("Boxes")["Box_" .. premium], "PlacedPill")), "rouvert : la carte dit ON FLOOR")

section("fin du mode pose : Q, écran rouvert, outil en main")
click(cardPart(cardsOf("Boxes")["Box_" .. standard], "PlaceButton"))
check(Inventory.GetState().Placing == standard, "mode pose du colis Standard")
pressKey("Q")
check(Inventory.GetState().Placing == nil, "Q : fin du mode")
click(INV.invButton)
click(cardPart(cardsOf("Boxes")["Box_" .. standard], "PlaceButton"))
click(INV.invButton)
check(Inventory.GetState().Placing == nil and INV.screen.Enabled, "écran rouvert : fin du mode")
click(cardPart(cardsOf("Boxes")["Box_" .. standard], "PlaceButton"))
pressKey("One")
flush()
check(Inventory.GetState().Placing == nil and ada.Character:FindFirstChildWhichIsA("Tool") ~= nil, "touche 1 : l'outil en main, fin du mode")
click(INV.invButton)
local placedCard = cardsOf("Boxes")["Box_" .. premium]
click(placedCard)
check(Inventory.GetState().Placing == nil and INV.screen.Enabled, "clic sur un colis posé : rien")

summary("scénario boxes")
