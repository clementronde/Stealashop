---------------------------------------------------------------- scénario « timer » : TimerTick du vrai HudController
local T = UiMotionC.TimerTick
local Motion = requireModule(MOTION_MODULE, "client")
local played = {}
Motion.SetSoundPlayer(function(name)
	table.insert(played, name)
end)
P1:SetAttribute("Cash", 100)
P1:SetAttribute("Income", 1)
local hud = makeHud()
local Heist = requireModule(HEIST_MODULE, "client")
local Hud = requireModule(HUD_MODULE, "client")
taskLib.spawn(Hud.Start)
step(0.1)
local timer = el(hud, "HeistTimer")
local box = el(timer, "Box")
local snap = snapshot(hud)

print("\n== T1. Le chrono sursaute à chaque seconde")
Heist.Emit("Z1_Store", Workspace:GetServerTimeNow() + 4.5)
step(1 / 30)
check(timer.Visible and timer.Text == "HEIST: 5s", `T1a chrono affiché ({timer.Text})`)
check(countClass(box, "UIScale") == 0 and #played == 0, "T1b à l'apparition : pas de tic (Motion.Show fait l'entrée)")
step(0.5)
check(timer.Text == "HEIST: 4s", "T1c une seconde de moins")
local pop = scaleNamed(box, UiMotionC.PopScaleName)
check(pop ~= nil and pop.Scale > 1, `T1d Box sursaute (× {pop and pop.Scale})`)
check(#played == 1 and played[1] == T.Sound, `T1e tic {T.Sound}`)
step(T.Time + 0.05)
check(countClass(box, "UIScale") == 0, "T1f sursaut fini : UIScale retiré")
step(1)
check(#played == 2, "T1g une seconde plus tard : un autre tic")
step(3)
check(timer.Visible == false, "T1h chrono fini : caché")

print("\n== T2. Sans Box : HeistTimer lui-même")
box:Destroy()
Heist.Emit("Z1_Store", Workspace:GetServerTimeNow() + 3.5)
step(UiMotionC.Show.Time + 0.1)
check(countClass(timer, "UIScale") == 0, "T2a apparition finie : aucun UIScale")
step(0.3) -- la seconde change à 0,5 s : sursaut en cours
check(scaleNamed(timer, UiMotionC.PopScaleName) ~= nil, "T2b HeistTimer sursaute")
step(4)
check(countClass(timer, "UIScale") == 0 and timer.Visible == false, "T2c fini, rien n'est laissé")

summary()
