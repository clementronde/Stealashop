--!nocheck
-- Banc a266, scénario « coupé » : quêtes et roue coupées. Aucun attribut, remotes ignorés, écrans jamais ouverts.
advance(1000)
startServer()
questTest("days 10")
wheelTest("days 10")
local ada = join("Ada", newProfile8(), 81)
advance(2)
section("coupé")
check(not logHas("[Loader", "WARN"), "aucun module en échec au chargement")
check(ada:GetAttribute("Quest1") == nil and ada:GetAttribute("QuestsEndsAt") == nil, "quêtes coupées : aucun attribut")
check(ada:GetAttribute("WheelFreeReady") == nil and ada:GetAttribute("WheelNextFreeAt") == nil, "roue coupée : aucun attribut")
check(QuestService.GetState(ada) == nil and WheelService.GetState(ada) == nil, "GetState : nil")
local cash = dataOf(ada).Cash
advance(1.1)
fireAs(ada, "SpinWheel"); flush()
fireAs(ada, "ClaimQuest", 1); flush()
check(#wheelResults(ada) == 0 and #notifies(ada) == 0 and dataOf(ada).Cash == cash, "SpinWheel et ClaimQuest ignorés")
check(dataOf(ada).Wheel == nil, "profil : pas de champ Wheel créé")
buildUi(ada)
buildQuestUi(ada)
startClient(ada)
advance(0.5)
click(QUI.questButtons[1])
click(QUI.wheelButtons[1])
clientModule("WheelController").Open()
clientModule("QuestController").Open()
advance(0.5)
check(not QUI.quests.Enabled and not QUI.wheelGui.Enabled, "écrans jamais ouverts")
check(not QUI.questAlerts[1].Visible and not QUI.wheelAlerts[1].Visible, "pastilles éteintes")
check(#serverCalls("SpinWheel") == 1 and #serverCalls("ClaimQuest") == 1, "le client n'envoie rien")
summary("scénario coupé")
