--!nocheck
-- Scénario « switch » : Config/Telemetry.Enabled = false (pre.switch.luau). Rien n'est envoyé à
-- AnalyticsService, ni économie, ni événement custom, ni étape du funnel (TutorialService) ; le jeu
-- marche comme avant (encaissement, achats, tuto, vol, colis tombé, capture) ; l'API répond false.

startServer()

local ada = join("Ada", richProfile(20000))
local adaData = DataService.Get(ada)
local bob = join("Bob", newProfile())
local dan = join("Dan", newProfile())
local kim = join("Kim", tutorialProfile())
giveBat(bob)
advance(1.2)

section("démarrage")
check(Telemetry.Enabled == false, "Config/Telemetry.Enabled = false")
check(logHas("[TelemetryService] Config.Telemetry.Enabled = false : rien n'est envoyé à AnalyticsService", "PRINT", "server"), "une ligne au démarrage")
check(not logHas("économie et événements custom branchés"), "rien n'est branché")
check(not logHas("[Loader", "WARN"), "aucun module en échec au chargement")
check(kim:GetAttribute("TutorialStep") == 1, "Kim a quand même son tuto (étape 1)")
check(not logHas("[TutorialService] funnel"), "aucune étape du funnel envoyée")

section("le jeu marche, rien ne part")
advance(2)
local a1 = cashOut(ada)
check(a1 > 0 and adaData.Cash == 20000 + a1, "encaissement fait")
goWeaponShop(ada)
buy(ada, "Wrench")
check(table.find(adaData.Tools.Owned, "Wrench") ~= nil, "outil acheté")
goHome(ada)
buy(ada, "Treadmill")
check(adaData.Upgrades.Treadmill == 1, "amélioration achetée")
goAuraShop(ada)
buy(ada, "Spark")
buy(ada, "Dust")
check(#adaData.Cosmetics.Auras == 1 and #adaData.Cosmetics.Trails == 1, "aura et trail achetés")
moveTo(dan, Vector3.new(420, 3, 0), Vector3.new(0, 0, -1))
local def = Items.ByZone[2].Rare[1]
check(CarryService.StartCarry(dan, { Kind = "NPCBox", Tier = "Standard", Zone = 2, Rarity = "Rare", ItemId = def.Id, StoreId = "STORE_Z2_Kiosque", SlotId = "S1" }), "Dan porte un colis hors zone safe")
moveTo(bob, Vector3.new(420, 3, 4), Vector3.new(0, 0, -1))
humanoidOf(bob):EquipTool(batOf(bob))
fireAs(bob, "SwingBat")
flush()
check(not CarryService.IsCarrying(dan), "colis tombé à la batte")
advance(3.2)
check(CarryService.StartCarry(dan, { Kind = "NPCBox", Tier = "Standard", Zone = 2, Rarity = "Rare", ItemId = def.Id, StoreId = "STORE_Z2_Kiosque", SlotId = "S2" }), "Dan reporte un colis")
CarryService.Fail(dan, "Caught")
flush()
local adaShop = shopOf(ada)
goHome(bob)
check(breakDoor(bob, adaShop), "porte d'Ada cassée par Bob")
check(steal(bob, adaShop, 1), "Bob prend les Écouteurs")
runHome(bob, adaShop)
check(DataService.Get(bob).Items["r-earbuds"] ~= nil, "vol déposé chez Bob")
advance(61)
leave(ada)
flush()
check(analyticsCount() == 0, `aucun appel à AnalyticsService (trouvé {analyticsCount()})`)

section("l'API répond false")
check(TelemetryService.LogEconomy(bob, "Fence", 100, "Rare") == false, "LogEconomy : false")
check(TelemetryService.LogEvent(bob, "DefenseBought") == false, "LogEvent : false")
check(analyticsCount() == 0, "toujours aucun appel")

section("fin")
check(not logHas("[TelemetryService]", "WARN"), "aucun avertissement de TelemetryService")
check(not logHas("ERREUR"), "aucune erreur dans les tâches")
summary("scénario switch")
