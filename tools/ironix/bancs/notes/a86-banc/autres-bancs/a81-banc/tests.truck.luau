--!nocheck
-- a81 (vague 26) : SFX_TruckArrive à l'apparition du camion, SFX_TruckBrake BrakeDelay s après, sur Root ;
-- rien pour un camion reçu tard (streaming) ; sons absents sans erreur.
local TruckEvent = sharedModule("Config/TruckEvent", "client")
local alice = newPlayer("Alice")
spawnCharacter(alice, Vector3.new(200, 3, 30))
startClient(alice)
local function placeTruck(x, age)
	local model = TRUCK_ASSET:Clone()
	model.Name = "EventTruck"
	model:SetAttribute("Zone", 3)
	model:SetAttribute("WindowId", "Truck_1")
	model:SetAttribute("MaxHP", 1000)
	model:SetAttribute("HP", 1000)
	model:SetAttribute("SpawnedAt", Workspace:GetServerTimeNow() - (age or 0))
	model:PivotTo(CFrame.new(x, 0, 0))
	model.Parent = Workspace
	addTag(model, "EventTruck")
	flush()
	return model
end
section("A. Noms et valeurs")
check(TruckEvent.ArriveSound == "SFX_TruckArrive" and TruckEvent.BrakeSound == "SFX_TruckBrake", "A1 noms de Clément")
check(math.abs(TruckEvent.BrakeDelay - 0.78 * 3) < 1e-6, "A2 freins à 78 % des 3 s du prototype")

section("B. Sons absents")
local t0 = placeTruck(200)
advance(TruckEvent.BrakeDelay + 0.2)
check(#soundsNamed("SFX_TruckArrive") == 0 and #soundsNamed("SFX_TruckBrake") == 0, "B1 rien ne joue")
check(logHas("SFX_TruckArrive absent", nil, "client"), "B2 une ligne en Studio")
t0:Destroy()
flush()

section("C. Arrivée")
addSfx("SFX_TruckArrive", { Volume = 0.8 })
addSfx("SFX_TruckBrake", { Volume = 0.7 })
local truck = placeTruck(220)
advance(1 / 30)
local arrive = soundsNamed("SFX_TruckArrive")
check(#arrive == 1 and arrive[1].Parent == truck.Root and arrive[1].Volume == 0.8, "C1 klaxon sur Root, au volume de Clément")
check(#soundsNamed("SFX_TruckBrake") == 0, "C2 pas encore de freins")
advance(TruckEvent.BrakeDelay - 0.2)
check(#soundsNamed("SFX_TruckBrake") == 0, "C3 freins pas avant BrakeDelay")
advance(0.3)
local brake = soundsNamed("SFX_TruckBrake")
check(#brake == 1 and brake[1].Parent == truck.Root, "C4 freins sur Root à BrakeDelay")
truck:Destroy()
flush()

section("D. Camion reçu tard")
local late = placeTruck(240, TruckEvent.ArriveMaxAge + 2)
advance(TruckEvent.BrakeDelay + 0.3)
check(#soundsNamed("SFX_TruckArrive") == 0 and #soundsNamed("SFX_TruckBrake") == 0, "D1 rien pour un camion déjà là")
late:Destroy()
flush()

section("E. Camion parti avant les freins")
local gone = placeTruck(260)
advance(0.5)
gone:Destroy()
flush()
advance(TruckEvent.BrakeDelay)
check(#soundsNamed("SFX_TruckBrake") == 0, "E1 pas de freins après le départ")
summary("scénario a81 truck")
