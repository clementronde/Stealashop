--!nocheck
-- Point 4 : ZoneReached, la 1re entrée d'un profil dans une zone (1 à 6), avec le temps de jeu cumulé ; une seule
-- fois par zone et par profil (champ ZonesReached), même après un départ et un retour.
local inbox = folder(Workspace, "_INBOX_CLEMENT")
makeGates(320, 100, 5)
-- Arche de la zone 6 déposée dans _INBOX_CLEMENT (pas dans la map) : ignorée.
local stray = make("Model", { Name = "ENV_ZoneGate_6" })
local post = make("Part", { Name = "Post", Anchored = true, Size = Vector3.new(2, 10, 2), CFrame = CFrame.new(340, 5, 0) }, stray)
stray.PrimaryPart = post
stray:SetAttribute("Zone", 6)
addTag(stray, "ZoneGate")
stray.Parent = inbox
startServer()
local data = plainProfile("a")
local ada = join("Ada", data)
section("hub")
moveTo(ada, Vector3.new(0, 3, 0))
advance(1.2)
check(#eventsNamed("ZoneReached") == 0, "rien dans le hub")
moveTo(ada, Vector3.new(310, 3, 0))
advance(1.2)
check(#eventsNamed("ZoneReached") == 0, "rien avant la 1re arche")
section("zone 1")
moveTo(ada, Vector3.new(345, 3, 0))
advance(1.2)
local list = eventsNamed("ZoneReached", ada)
check(#list == 1 and fieldOf(list[1], 1) == "Zone - 1", `ZoneReached Zone - 1 (trouvé {#list})`)
check(list[1] ~= nil and list[1].value >= 3600 and list[1].value < 3700, `valeur = temps de jeu cumulé (3600 s + la session) : {list[1] and list[1].value}`)
check(data.ZonesReached ~= nil and list[1] ~= nil and data.ZonesReached["1"] == list[1].value, "gardé dans le profil (ZonesReached)")
check(data.ZonesReached == nil or data.ZonesReached["6"] == nil, "l'arche de _INBOX_CLEMENT est ignorée")
check(logHas("Ada : ZoneReached = ", "PRINT", "server"), "Studio : une ligne")
moveTo(ada, Vector3.new(310, 3, 0))
advance(1.2)
moveTo(ada, Vector3.new(345, 3, 0))
advance(1.2)
check(#eventsNamed("ZoneReached", ada) == 1, "repasser l'arche 1 n'envoie rien de plus")
section("saut de la zone 2 à la zone 3")
moveTo(ada, Vector3.new(530, 3, 0))
advance(1.2)
list = eventsNamed("ZoneReached", ada)
check(#list == 3 and fieldOf(list[2], 1) == "Zone - 2" and fieldOf(list[3], 1) == "Zone - 3", "Zone - 2 puis Zone - 3")
check(data.ZonesReached ~= nil and data.ZonesReached["2"] ~= nil and data.ZonesReached["3"] ~= nil, "zones 2 et 3 gardées")
section("départ et retour")
leave(ada)
advance(0.5)
local ada2 = join("Ada", data)
moveTo(ada2, Vector3.new(530, 3, 0))
advance(1.2)
check(#eventsNamed("ZoneReached") == 3, "même profil : les zones déjà atteintes ne repartent pas")
moveTo(ada2, Vector3.new(760, 3, 0))
advance(1.2)
list = eventsNamed("ZoneReached", ada2)
check(#list == 2 and fieldOf(list[1], 1) == "Zone - 4" and fieldOf(list[2], 1) == "Zone - 5", "zones 4 et 5 au retour")
check(data.ZonesReached ~= nil and data.ZonesReached["6"] == nil, "zone 6 jamais atteinte (pas d'arche dans la map)")
section("un autre joueur")
local bob = join("Bob", plainProfile("b"))
moveTo(bob, Vector3.new(345, 3, 0))
advance(1.2)
check(#eventsNamed("ZoneReached", bob) == 1, "Bob : sa propre zone 1")
check(noRefusal(), "Roblox accepte chaque envoi")
section("fin")
check(not logHas("[TelemetryService]", "WARN"), "aucun avertissement de TelemetryService")
check(not logHas("ERREUR"), "aucune erreur dans les tâches")
summary("scénario zones")
