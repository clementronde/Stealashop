--!nocheck
-- Scénario « stock » (a111, vague 33, demande de Cantin du 2026-11-13) : la potion ramassée va dans
-- l'inventaire (champ facultatif PotionStock du profil, attribut PotionStock_<Id>), le joueur la boit par
-- UsePotion. Profil sans potions, profil abîmé nettoyé, ramassage → stock, plafond (potion laissée par terre,
-- un seul message), utilisation → effet (cumul), refus (Id inconnu, stock vide, mort, profil pas chargé),
-- mort et clear ne vident pas l'inventaire, crochet stock.
startPotions()
local P = POTIONS_CFG
local adaData = newProfile()
local ada = join("Ada", adaData)
local bobData = newProfile()
bobData.PotionStock = { Speed = 3.7, Money = 99, Beer = 2, Strength = -1, Invisibility = "x" }
local bob = join("Bob", bobData)
advance(0.3)

section("profil sans potions, profil abîmé")
check(P.MaxStock == 5 and P.StockAttributePrefix == "PotionStock_", "Config : MaxStock 5, préfixe PotionStock_")
local zeros = true
for _, potion in P.List do
	zeros = zeros and stock(ada, potion.Id) == 0
end
check(zeros, "Ada (profil sans potions) : chaque attribut PotionStock_<Id> = 0")
check(adaData.PotionStock == nil and adaData.Version == 2, "profil sans potions : champ toujours absent, version inchangée")
check(bobData.PotionStock and bobData.PotionStock.Speed == 3 and bobData.PotionStock.Money == 5, "abîmé : Speed 3,7 → 3, Money 99 → 5 (plafond)")
check(bobData.PotionStock.Beer == nil and bobData.PotionStock.Strength == nil and bobData.PotionStock.Invisibility == nil, "abîmé : Id inconnu, nombre négatif et texte retirés")
check(stock(bob, "Speed") == 3 and stock(bob, "Money") == 5 and stock(bob, "Strength") == 0, "abîmé : attributs posés d'après le profil nettoyé")

section("ramassage → stock")
local uid, position = spawnNear(ada, "Money")
moveTo(ada, position + Vector3.new(0, 3, 0))
pick(ada, uid)
check(livePotions(ada)[uid] == nil and stock(ada, "Money") == 1, "ramassée : retirée du sol, PotionStock_Money = 1")
check(adaData.PotionStock and adaData.PotionStock.Money == 1, "profil : PotionStock.Money = 1 (sauvegardé avec le profil)")
check(attr(ada, "Money") == nil and DisplayService.GetIncomeMultiplier(ada) == 1, "pas d'effet au ramassage")
check(lastNotify(ada) == "Money potion added to your inventory!", `message : « {lastNotify(ada)} »`)
local uid2, pos2 = spawnNear(ada, "Money")
moveTo(ada, pos2 + Vector3.new(0, 3, 0))
pick(ada, uid2)
check(stock(ada, "Money") == 2, "2e Money : stock 2")

section("plafond")
for _ = 1, 3 do
	test("Ada stock Money")
end
check(stock(ada, "Money") == P.MaxStock, `crochet stock : 5 Money (trouvé {stock(ada, "Money")})`)
test("Ada stock Money")
check(stock(ada, "Money") == P.MaxStock, "crochet stock au plafond : reste à 5")
local full, fpos = spawnNear(ada, "Money")
moveTo(ada, fpos + Vector3.new(0, 3, 0))
local nFull = #notifies(ada, "full")
pick(ada, full)
advance(1)
pick(ada, full)
advance(1)
pick(ada, full)
check(livePotions(ada)[full] ~= nil and stock(ada, "Money") == P.MaxStock, "plafond : la potion reste par terre, stock 5")
local fulls = notifies(ada, "full")
check(#fulls == nFull + 1, `plafond : un seul message pour 3 essais (trouvé {#fulls - nFull})`)
local fe = fulls[#fulls]
check(fe and fe.args[1] == "Your Money potions are full (5/5)." and fe.args[2] == "Warning", `message : « {fe and fe.args[1]} » ({fe and fe.args[2]})`)
check(logHas("plafond de l'inventaire", "WARN", "server"), "plafond : une ligne en Studio")
local sUid, sPos = spawnNear(ada, "Speed")
moveTo(ada, sPos + Vector3.new(0, 3, 0))
pick(ada, sUid)
check(stock(ada, "Speed") == 1, "plafond par type : une Speed passe encore")

section("utilisation → effet, cumul")
advance(1)
local t = serverNow()
use(ada, "Money")
check(stock(ada, "Money") == 4 and adaData.PotionStock.Money == 4, "bue : stock 5 → 4")
local e1 = attr(ada, "Money")
check(e1 and math.abs(e1 - t - 120) < 0.5 and DisplayService.GetIncomeMultiplier(ada) == 2, "effet Money : 120 s, revenus ×2")
check(lastNotify(ada) == "Money ×2 for 2:00!", `message : « {lastNotify(ada)} »`)
advance(1)
use(ada, "Money")
local e2 = attr(ada, "Money")
check(e2 and math.abs(e2 - e1 - 120) < 0.5 and stock(ada, "Money") == 3, "déjà actif : la durée s'ajoute (cumul), stock 3")
check(string.find(lastNotify(ada), "Money ×2 for 3:", 1, true) == 1, `message du cumul : « {lastNotify(ada)} »`)
check(DisplayService.GetIncomeMultiplier(ada) == 2, "cumul : toujours ×2 (pas ×4)")
advance(1)
pick(ada, full)
check(livePotions(ada)[full] == nil and stock(ada, "Money") == 4, "sous le plafond : la potion laissée se ramasse")

section("refus")
advance(1)
local n0, s0 = #notifies(ada), stock(ada, "Speed")
use(ada, "Beer")
check(#notifies(ada) == n0 and logHas("potion inconnue", "WARN", "server"), "Id inconnu : rien, une ligne en Studio")
advance(1)
use(ada, "Invisibility")
check(attr(ada, "Invisibility") == nil and stock(ada, "Invisibility") == 0 and #notifies(ada) == n0, "aucune Invisibility : refusé, rien ne change")
check(logHas("aucune dans l'inventaire", "WARN", "server"), "stock vide : une ligne en Studio")
kill(ada)
advance(1)
use(ada, "Speed")
check(attr(ada, "Speed") == nil and stock(ada, "Speed") == s0, "mort : refusé, stock gardé")
check(logHas("pas de personnage vivant", "WARN", "server"), "mort : une ligne en Studio")
check(stock(ada, "Money") == 4 and adaData.PotionStock.Money == 4, "mort : l'inventaire reste (les effets partent)")
spawnCharacter(ada, Vector3.new(0, 3, 0))
advance(1)
use(ada, "Speed")
check(attr(ada, "Speed") ~= nil and stock(ada, "Speed") == s0 - 1, "réapparue : la Speed se boit")
test("Ada clear")
check(stock(ada, "Money") == 4 and attr(ada, "Speed") == nil, "crochet clear : effets retirés, inventaire gardé")
local cy = newPlayer("Cy")
spawnCharacter(cy, Vector3.new(0, 3, 0))
advance(0.5)
fireAs(cy, "UsePotion", "Speed")
advance(0.3)
check(attr(cy, "Speed") == nil and stock(cy, "Speed") == nil, "profil pas chargé : refusé, aucun attribut")
check(logHas("profil pas chargé", "WARN", "server"), "profil pas chargé : une ligne en Studio")

section("rafale")
advance(2)
local before = stock(bob, "Money")
for _ = 1, 10 do
	fireAs(bob, "UsePotion", "Money")
end
advance(0.5)
local after = stock(bob, "Money")
check(after >= 0 and after < before and after >= 1 and before - after <= 4, `10 envois de Money (5 en stock) d'un coup : débit borné ({before - after} bue(s), stock {after})`)
check(bobData.PotionStock == nil or (bobData.PotionStock.Money or 0) == after, "profil et attribut d'accord")
finish("scénario stock")
