# a296 : partie pieges-new du banc a293 = le jeu DEV. Features.NewTraps est coupé (PROD) et NewTrapsDev allumé (validés par
# Cantin, 21/11) ; Config/ProductIds forcé en Environment = "Dev" (IsDev vrai) : TrapService prend Traps.SlotLayoutNew.
s/^\t\tassert\(string\.find\(src, "[\]n[\]tNewTraps = true,", 1, true\), "a293 : Features\.NewTraps n.est pas allumé"\)$/\t\tassert(string.find(src, string.char(10, 9) .. "NewTraps = false,", 1, true) and string.find(src, string.char(10, 9) .. "NewTrapsDev = true,", 1, true), "a296 : NewTraps coupé et NewTrapsDev allumé attendus") do local pk = "shared\/Config\/ProductIds.luau" local ps, pn = string.gsub(SOURCES[pk], 'ENVIRONMENT: Environment = "Auto"', 'ENVIRONMENT: Environment = "Dev"') assert(pn == 1, "a296 : ENVIRONMENT de ProductIds introuvable") SOURCES[pk] = ps end -- a296/
s/^\tcheck\(Features\.NewTraps == true, "Features\.NewTraps = true \(validé par Cantin, 21\/11\)"\)$/\tcheck(Features.NewTraps == false and Features.NewTrapsDev == true and sharedModule("Config\/ProductIds").IsDev == true, "a296 : jeu DEV (IsDev), NewTraps coupé, NewTrapsDev allumé")/
