--!nocheck
-- Banc a318, RevealController : un magasin PNJ sort du streaming et revient 5 fois : une seule écoute de CeilingBroken
-- (avant a318 : une de plus à chaque retour). Plafond cassé (attribut du serveur) pendant la sortie : caché au retour.
local Reveal = requireModule(ReplicatedStorage.Shared.Config.Reveal)
local ATTR = Reveal.Ceiling.Attribute
local store = model({ Name = "Store_Z2_A" }, map())
store:SetAttribute("StoreId", "Z2_A")
store:SetAttribute("Zone", 2)
local ceiling = part({ Name = Reveal.Ceiling.Name, Position = Vector3.new(0, 20, 0) }, store)
part({ Name = "Bounds", Position = Vector3.new(0, 10, 0) }, store)
store:AddTag("NPCStore")
snapshot(store)

scenario("reveal")
startClientPhase()
startController("RevealController")
local signal = store:GetAttributeChangedSignal(ATTR)
check(liveConnections(signal) == 1, `au départ : une écoute de {ATTR} ({liveConnections(signal)})`)
cycles(store, 5, false)
check(liveConnections(signal) == 1, `5 sorties et retours : toujours une écoute ({liveConnections(signal)})`)
cycles(store, 2, true)
check(liveConnections(signal) == 1, `2 retours en perdant les changements locaux : une écoute ({liveConnections(signal)})`)
store:SetAttribute(ATTR, true)
advance(0.5)
check(ceiling.LocalTransparencyModifier == 1, "plafond cassé : caché")
streamOut(store)
advance(0.5)
streamIn(store, true)
advance(0.5)
check(ceiling.LocalTransparencyModifier == 1, "revenu en perdant les changements locaux, toujours cassé : recaché")
store:SetAttribute(ATTR, false)
advance(Reveal.Ceiling.LocalHold + 1)
check(ceiling.LocalTransparencyModifier == 0, "réparé : plafond revenu")
noErrors("reveal")
summary("reveal")
