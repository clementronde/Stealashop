--!nocheck
-- Banc a318, DisplayController : sa boutique sort du streaming (le joueur est au fond du couloir) et revient 5 fois :
-- une seule écoute du propriétaire par boutique (avant a318 : une de plus à chaque retour) ; la caisse est relue au
-- retour (0 tant que la boutique est sortie, comme quand elle n'est pas encore arrivée).
local plot = model({ Name = "Plot_1" }, map())
plot:SetAttribute("PlotIndex", 1)
plot:SetAttribute("OwnerUserId", LocalPlayer.UserId)
plot:SetAttribute("CashRegister", 50)
part({ Name = "Bounds" }, plot)
plot:AddTag("PlayerPlot")
LocalPlayer:SetAttribute("PlotIndex", 1)
snapshot(plot)

scenario("display")
startClientPhase()
local Display = startController("DisplayController")
local signal = plot:GetAttributeChangedSignal("OwnerUserId")
check(liveConnections(signal) == 1, `au départ : une écoute du propriétaire ({liveConnections(signal)})`)
check(Display.GetRegister() == 50, `caisse lue : {Display.GetRegister()}`)
streamOut(plot)
advance(0.2)
check(Display.GetRegister() == 0, "boutique sortie : caisse à 0 (pas de boutique chargée)")
check(liveConnections(signal) == 0, `boutique sortie : écoute retirée ({liveConnections(signal)})`)
streamIn(plot, false)
advance(0.2)
check(Display.GetRegister() == 50, "boutique revenue : caisse relue")
cycles(plot, 5, false)
cycles(plot, 2, true)
check(liveConnections(signal) == 1, `7 sorties et retours : toujours une écoute ({liveConnections(signal)})`)
plot:SetAttribute("CashRegister", 80)
advance(0.1)
check(Display.GetRegister() == 80, "après les retours : la caisse suit encore la boutique")
noErrors("display")
summary("display")
