---------------------------------------------------------------- scénario « trail » (vague 47, a155) : « ×2 » du trail après le gain du tapis
local F = UiMotionC.FloatGain
local Motion = requireModule(MOTION_MODULE, "client")
Motion.SetSoundPlayer(function() end)
P1:SetAttribute("Cash", 100)
P1:SetAttribute("Income", 10)
P1:SetAttribute("Speed", 10)
P1:SetAttribute("Strength", 5)
P1:SetAttribute("WalkSpeed", 16)
P1:SetAttribute("Damage", 1)
P1:SetAttribute("CashCollected", 0)
local hud = makeHud()
local gainSnap = snapshot(BB_GAIN)
local Hud = requireModule(HUD_MODULE, "client")
local Rewards = requireModule(REWARDS_MODULE, "client")
local Gain = requireModule(GAIN_MODULE, "client")
taskLib.spawn(Hud.Start)
taskLib.spawn(Gain.Start)
step(0.1)
local speed = 10
local function gainWith(trail)
	P1:SetAttribute("TrailMultiplier", trail)
	P1:SetAttribute("TrainingMachine", "Treadmill")
	speed += 1
	P1:SetAttribute("Speed", speed)
	local list = childrenNamed(PLAYER_GUI, "BB_Gain")
	return list[#list]
end
local function clear()
	P1:SetAttribute("TrainingMachine", nil)
	step(F.Time + 0.5)
end
local hex = F.TrailMultiplierColor:ToHex()

print("\n== T1. Sans Row.Multiplier")
check(sameColor(F.TrailMultiplierColor, Color3.fromHex("FFD84D")), "T1a couleur V0 #FFD84D")
local bb = gainWith(nil)
local amount = bb and el(bb, "Amount")
check(amount and amount.Text == "+1 Speed/s" and not amount.RichText, `T1b sans trail : texte inchangé ({amount and amount.Text})`)
clear()
bb = gainWith(1)
amount = bb and el(bb, "Amount")
check(amount and amount.Text == "+1 Speed/s", `T1c trail ×1 : texte inchangé ({amount and amount.Text})`)
clear()
bb = gainWith(2)
amount = bb and el(bb, "Amount")
check(amount and amount.RichText and amount.Text == `+1 Speed/s <font color="#{hex}">×2</font>`, `T1d trail ×2 ({amount and amount.Text})`)
clear()
bb = gainWith(12)
amount = bb and el(bb, "Amount")
check(amount and amount.Text == `+1 Speed/s <font color="#{hex}">×12</font>`, `T1e trail ×12 ({amount and amount.Text})`)
clear()
local same, why = sameAs(gainSnap, BB_GAIN)
check(same and not el(BB_GAIN, "Amount").RichText, `T1f modèle BB_Gain intact ({why})`)

print("\n== T2. Avec Row.Multiplier de Clément")
local label = new("TextLabel", { Name = "Multiplier", Text = "", Visible = true }, el(BB_GAIN, "Row"))
bb = gainWith(2)
amount = bb and el(bb, "Amount")
local m = bb and el(bb, "Multiplier")
check(amount and amount.Text == "+1 Speed/s" and m and m.Text == "×2" and m.Visible, `T2a ×2 dans Multiplier ({amount and amount.Text} / {m and m.Text})`)
clear()
bb = gainWith(12)
m = bb and el(bb, "Multiplier")
check(m and m.Text == "×12" and m.Visible, `T2b ×12 ({m and m.Text})`)
clear()
bb = gainWith(nil)
m = bb and el(bb, "Multiplier")
amount = bb and el(bb, "Amount")
check(m and not m.Visible and amount.Text == "+1 Speed/s", "T2c sans trail : Multiplier caché, texte inchangé")
clear()
label.Parent = nil
summary()
