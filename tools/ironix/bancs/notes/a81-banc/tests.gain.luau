---------------------------------------------------------------- scénario « gain » (a81, vague 26) : Train_Gain
local F = UiMotionC.FloatGain
local Motion = requireModule(MOTION_MODULE, "client")
local played = {}
Motion.SetSoundPlayer(function(name) table.insert(played, name) end)
local function count(name)
	local n = 0
	for _, p in played do if p == name then n += 1 end end
	return n
end
P1:SetAttribute("Cash", 100)
P1:SetAttribute("Income", 10)
P1:SetAttribute("Speed", 10)
P1:SetAttribute("Strength", 5)
P1:SetAttribute("WalkSpeed", 16)
P1:SetAttribute("Damage", 1)
P1:SetAttribute("CashCollected", 0)
local hud = makeHud()
local Hud = requireModule(HUD_MODULE, "client")
local Rewards = requireModule(REWARDS_MODULE, "client")
local Gain = requireModule(GAIN_MODULE, "client")
taskLib.spawn(Hud.Start)
taskLib.spawn(Gain.Start)
step(0.1)
print("\n== T1. Tapis : un Train_Gain par gain affiché")
P1:SetAttribute("TrainingMachine", "Treadmill")
P1:SetAttribute("Speed", 12)
step(0.05)
check(count("Train_Gain") == 1, `T1a un son au premier gain ({count("Train_Gain")})`)
P1:SetAttribute("Speed", 13)
step(0.05)
P1:SetAttribute("Speed", 14)
step(0.05)
check(count("Train_Gain") == 1, "T1b gains rapprochés : pas de son de plus avant le BB_Gain suivant")
step(F.MinGap + 0.1)
check(count("Train_Gain") == 2, `T1c le BB_Gain suivant (gains cumulés) : un son ({count("Train_Gain")})`)
print("\n== T2. Banc")
P1:SetAttribute("TrainingMachine", "Bench")
step(F.MinGap + 0.1)
P1:SetAttribute("Strength", 9)
step(0.05)
check(count("Train_Gain") == 3, "T2a gain de force : un son")
P1:SetAttribute("TrainingMachine", nil)
print("\n== T3. Argent")
P1:SetAttribute("Cash", 1300)
P1:SetAttribute("CashCollected", 1200)
step(3)
check(count("Train_Gain") == 3, "T3a l'argent ne joue pas Train_Gain")
summary()
