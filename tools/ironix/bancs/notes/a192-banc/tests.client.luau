--!nocheck
-- a192 (vague 59, L-184 points 1, 2 et 4 ; L-182 point 9), côté client, mise en place du banc a68 (a42 copie a71) :
--   M HUD masqué pendant la poursuite (sauf UI_Chase, HeistTimer, DropButton ; UI_Notify jamais), Highlight rouge,
--     rendu à la fin ; A alerte en deux paliers (HeistHint) ; C capture (jour, V0 ; nuit avec UI_Caught et bandes ;
--     mort au milieu ; deux captures d'affilée) ; K carte « ITEM SECURED! » avec et sans « NEW! ».
buildFeelAssets()
local Feel = sharedModule("Config/HeistFeel", "client")
local IndexCfg = sharedModule("Config/Index", "client")
local ItemsCfg = sharedModule("Config/Items", "client")
local item = nil
for _, def in ItemsCfg.List do
	if def.Zone ~= nil and item == nil then
		item = def
	end
end
local alice = newPlayer("Alice")
spawnCharacter(alice, Vector3.new(zoneMiddle(1), 3, 0))
make("TextLabel", { Name = "HeistHint", Text = "NOBODY SAW YOU... YET", Visible = false }, STARTER_CHASE)
copyScreen(alice, STARTER_CHASE)
local hud = make("ScreenGui", { Name = "UI_HUD" }, alice.PlayerGui)
local rail = make("Frame", { Name = "LeftRail", Visible = true }, hud)
local cashLabel = make("TextLabel", { Name = "Cash", Text = "$100", Visible = true }, hud)
local timer = make("TextLabel", { Name = "HeistTimer", Text = "HEIST: 6s", Visible = true }, hud)
local bottom = make("Frame", { Name = "BottomRow", Visible = true }, hud)
local drop = make("TextButton", { Name = "DropButton", Visible = true }, bottom)
local other = make("TextButton", { Name = "OtherButton", Visible = true }, bottom)
local hotbar = make("ScreenGui", { Name = "UI_Hotbar", Enabled = true }, alice.PlayerGui)
local notify = make("ScreenGui", { Name = "UI_Notify", Enabled = true }, alice.PlayerGui)
local shop = make("ScreenGui", { Name = "UI_WeaponShop", Enabled = false }, alice.PlayerGui)
Workspace.CurrentCamera = CAMERA
CAMERA.CameraType = "Enum.CameraType.Custom"
startClient(alice)
local Heist = clientModule("HeistController")
local Scene = clientModule("CatchSceneController")
local guard = buildGuard(alice, zoneMiddle(1) + 20)
local chaseGui = alice.PlayerGui:FindFirstChild("UI_Chase")

section("M. HUD masqué pendant la poursuite")
advance(0.3)
serverFire("ChaseState", alice, true, guard)
advance(1 / 30)
check(hotbar.Enabled == false and shop.Enabled == false, "M1 UI_Hotbar masqué (UI_WeaponShop reste éteint)")
check(rail.Visible == false and cashLabel.Visible == false and other.Visible == false, "M2 LeftRail, Cash et le reste du HUD cachés")
check(timer.Visible == true and drop.Visible == true and bottom.Visible == true, "M3 HeistTimer, DropButton (et son cadre) gardés")
check(notify.Enabled == true and hud.Enabled == true, "M4 UI_Notify jamais touché ; UI_HUD reste allumé (masque partiel)")
check(chaseGui.Enabled == true, "M5 UI_Chase allumé (RUN!)")
local mark = guard:FindFirstChild(Feel.Highlight.Name)
check(mark ~= nil and mark:IsA("Highlight") and mark.Adornee == guard and mark.FillColor == Feel.Highlight.FillColor, "M6 vigile en rouge (Highlight du client)")
cashLabel.Visible = true
advance(Feel.MaskRefresh + 0.05)
check(cashLabel.Visible == false, "M7 rallumé par un autre code : recaché")
serverFire("ChaseState", alice, false)
advance(1 / 30)
check(hotbar.Enabled == true and shop.Enabled == false, "M8 fin : UI_Hotbar revenu, UI_WeaponShop toujours éteint")
check(rail.Visible and cashLabel.Visible and other.Visible and timer.Visible and drop.Visible, "M9 fin : tout le HUD revenu")
check(guard:FindFirstChild(Feel.Highlight.Name) == nil, "M10 Highlight retiré")

section("A. Alerte en deux paliers")
advance(0.5)
Heist.timers.S1 = Workspace:GetServerTimeNow() + 10
advance(0.3)
local edge = chaseGui:FindFirstChild("RedEdge")
local warning = chaseGui:FindFirstChild("Warning")
local hintCopy = chaseGui:FindFirstChild("HeistHint")
check(chaseGui.Enabled == true and hintCopy.Visible == true, "A1 braquage, personne ne poursuit : UI_Chase allumé, HeistHint visible")
check(edge.Visible == false and warning.Visible == false, "A2 seul HeistHint : bords et avertissement cachés")
check(rail.Visible == true, "A3 le HUD n'est pas masqué au palier 1")
serverFire("ChaseState", alice, true, guard)
advance(1 / 30)
check(hintCopy.Visible == false and edge.Visible == true and warning.Visible == true, "A4 repéré : à l'image suivante, RUN! et bords, plus de HeistHint")
serverFire("ChaseState", alice, false)
Heist.timers.S1 = nil
advance(0.5)
check(chaseGui.Enabled == false, "A5 fin du braquage : UI_Chase éteint")
check(edge.Visible == true and warning.Visible == true and hintCopy.Visible == false, "A6 enfants remis comme Clément les a faits")
Heist.timers.S2 = Workspace:GetServerTimeNow() + 2
advance(0.3)
check(chaseGui.Enabled == true and hintCopy.Visible == true, "A7 nouveau braquage : palier 1")
advance(2)
check(chaseGui.Enabled == false and edge.Visible == true, "A8 chrono fini sans poursuite : éteint, enfants remis")
Heist.timers.S2 = nil

section("C. Capture de jour, sans UI_Caught (écran V0)")
advance(0.5)
serverFire("CatchScene", alice, false, "Shelf", 0, item.Id)
local v0 = alice.PlayerGui:FindFirstChild(Feel.Catch.V0Screen)
check(Scene.GetState().Active and Scene.GetState().Scenes == 1, "C1 scène lancée")
check(hud.Enabled == false and hotbar.Enabled == false and notify.Enabled == true, "C2 tout le HUD coupé (UI_Notify gardé)")
check(v0 ~= nil and v0.Enabled == true, "C3 écran V0 du code allumé")
check(CAMERA.CameraType == "Enum.CameraType.Scriptable", "C4 caméra prise")
check(v0 and v0.Title.Visible == false, "C5 « CAUGHT! » pas encore là (plongeon, plan bas)")
check(v0 and v0.BarTop.Visible == false, "C6 de jour : pas de bandes")
advance(Feel.Catch.DiveTime + Feel.Catch.LowHold + 0.05)
check(v0 and v0.Title.Visible == true and Scene.GetState().Phase == "Stamp", "C7 « CAUGHT! » tamponné après le plan bas")
advance(Feel.Catch.SceneTime)
check(not Scene.GetState().Active and v0.Parent == nil, "C8 fin : écran V0 détruit")
check(hud.Enabled == true and hotbar.Enabled == true, "C9 HUD rendu")
check(CAMERA.CameraType == "Enum.CameraType.Custom", "C10 caméra rendue")

section("C'. Capture de nuit avec UI_Caught de Clément")
local caught = make("ScreenGui", { Name = "UI_Caught", Enabled = false }, alice.PlayerGui)
local title = make("TextLabel", { Name = "Title", Text = "CAUGHT!", Rotation = 0, TextTransparency = 0, Visible = true }, caught)
local icon = make("ImageLabel", { Name = "ItemIcon", Position = UDim2.fromScale(0.5, 0.6), Visible = true }, caught)
local top = make("Frame", { Name = "BarTop", Size = UDim2.fromScale(1, 0.5), Visible = true }, caught)
local bot = make("Frame", { Name = "BarBottom", Size = UDim2.fromScale(1, 0.5), Visible = true }, caught)
serverFire("CatchScene", alice, true, "Drop", 0.6, item.Id)
check(caught.Enabled and top.Size.Y.Scale == 0 and bot.Size.Y.Scale == 0 and top.Visible, "C11 bandes ouvertes (0) au départ")
check(alice.PlayerGui:FindFirstChild(Feel.Catch.V0Screen) == nil, "C12 pas d'écran V0 avec UI_Caught")
advance(0.6 - Feel.Catch.BandsClose + 0.05)
check(top.Size.Y.Scale == 0.5 and bot.Size.Y.Scale == 0.5 and Scene.GetState().Phase == "Bands", "C13 bandes fermées avant le renvoi")
check(CAMERA.CameraType == "Enum.CameraType.Scriptable", "C14 caméra encore prise dans le noir")
advance(Feel.Catch.BandsClose + Feel.Catch.BandsHold)
check(CAMERA.CameraType == "Enum.CameraType.Custom" and top.Size.Y.Scale == 0, "C15 renvoi caché : caméra rendue, bandes rouvertes")
check(title.Visible == true, "C16 « CAUGHT! » après les bandes")
advance(3)
check(not Scene.GetState().Active and caught.Enabled == false, "C17 fin : UI_Caught éteint")
check(top.Size.Y.Scale == 0.5 and icon.Position.Y.Scale == 0.6 and title.Rotation == 0 and title.TextTransparency == 0, "C18 valeurs de Clément remises (bandes, icône, titre)")
check(hud.Enabled == true, "C19 HUD rendu")

section("C''. Mort au milieu, puis deux captures d'affilée")
serverFire("CatchScene", alice, false, "None", 0, nil)
advance(0.2)
alice.Character.Humanoid.Died:Fire()
advance(1 / 30)
check(not Scene.GetState().Active and hud.Enabled == true and CAMERA.CameraType == "Enum.CameraType.Custom", "C20 mort : tout est rendu tout de suite")
serverFire("CatchScene", alice, false, "Drop", 0, item.Id)
advance(0.2)
serverFire("CatchScene", alice, false, "Drop", 0, item.Id)
check(Scene.GetState().Active and hud.Enabled == false, "C21 deuxième capture : une scène, HUD coupé")
advance(Feel.Catch.SceneTime + 0.2)
check(not Scene.GetState().Active and hud.Enabled == true and caught.Enabled == false, "C22 fin : tout rendu une seule fois")

section("K. Carte « ITEM SECURED! »")
local escape = make("ScreenGui", { Name = "UI_Escape", Enabled = false }, alice.PlayerGui)
local card = make("Frame", { Name = "Card" }, escape)
local cName = make("TextLabel", { Name = "ItemName", Text = "" }, card)
local cRarity = make("TextLabel", { Name = "Rarity", Text = "" }, card)
local cIncome = make("TextLabel", { Name = "Income", Text = "" }, card)
local cNew = make("TextLabel", { Name = "NewBadge", Text = "NEW!", Visible = false }, card)
make("ImageLabel", { Name = "ItemIcon" }, card)
serverFire("ItemSecured", alice, item.Id)
check(cName.Text == item.DisplayName, `K1 nom ({cName.Text})`)
check(cRarity.Text ~= "" and string.find(cIncome.Text, "^%+%$") ~= nil and string.find(cIncome.Text, "/s$") ~= nil, `K2 rareté et revenu ({cRarity.Text}, {cIncome.Text})`)
check(cNew.Visible == true, "K3 pas encore dans l'index : « NEW! »")
alice:SetAttribute(IndexCfg.Attribute, IndexCfg.Encode({ [item.Id] = true }))
advance(0.1)
serverFire("ItemSecured", alice, item.Id)
check(cNew.Visible == true, "K4 découverte juste avant (moins de NewWindow s) : encore « NEW! »")
advance(Feel.Card.NewWindow + 0.5)
serverFire("ItemSecured", alice, item.Id)
check(cNew.Visible == false and Scene.GetState().Cards == 3, "K5 déjà dans l'index : pas de « NEW! »")
card:Destroy()
serverFire("ItemSecured", alice, item.Id)
check(Scene.GetState().Cards == 3, "K6 sans Card : rien")

check(not logHas("[CatchScene] remotes", nil, "client"), "Z1 remotes CatchScene et ItemSecured branchés")
summary("scénario client")
