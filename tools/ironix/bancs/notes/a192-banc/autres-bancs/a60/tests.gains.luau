---------------------------------------------------------------- scénario « gains » : le vrai GainController (avec le vrai HudController)
local F, FLY, BUMP, POP = UiMotionC.FloatGain, UiMotionC.CashFly, UiMotionC.CashBump, UiMotionC.CounterPop
local Motion = requireModule(MOTION_MODULE, "client")
local played = {}
Motion.SetSoundPlayer(function(name)
	table.insert(played, name)
end)
P1:SetAttribute("Cash", 100)
P1:SetAttribute("Income", 10)
P1:SetAttribute("Speed", 10)
P1:SetAttribute("Strength", 5)
P1:SetAttribute("WalkSpeed", 16)
P1:SetAttribute("Damage", 1)
P1:SetAttribute("CashCollected", 0)
local hud = makeHud()

local gainSnap = snapshot(BB_GAIN)
local Hud = requireModule(HUD_MODULE, "client")
local Rewards = requireModule(REWARDS_MODULE, "client")
local Gain = requireModule(GAIN_MODULE, "client")
taskLib.spawn(Hud.Start)
taskLib.spawn(Gain.Start)
step(0.1)
local hudSnap = snapshot(hud) -- après le branchement (boutons cachés par Config/Features)
local cash = el(hud, "Cash")
local cashRow = el(hud, "CashRow")
local root = P1.Character.HumanoidRootPart

local function gains()
	return childrenNamed(PLAYER_GUI, "BB_Gain")
end
local function flyers()
	return childrenNamed(hud, "Template")
end
local function pops()
	return childrenNamed(hud, "CounterPop")
end
local FLY_TOTAL = FLY.PopTime + FLY.Hold + FLY.Time

print("\n== G1. Tapis : « +2 Speed/s » au-dessus du joueur")
check(cash.Text == "$100", "G1a départ : « $100 »")
P1:SetAttribute("TrainingMachine", "Treadmill")
P1:SetAttribute("Speed", 12)
local list = gains()
check(#list == 1, `G1b un BB_Gain dans le PlayerGui ({#list})`)
local bb = list[1]
check(bb ~= nil and bb ~= BB_GAIN and bb.Adornee == root, "G1c une copie de BB_Gain, posée sur le HumanoidRootPart")
check(bb and el(bb, "Amount").Text == "+2 Speed/s", `G1d texte « +2 Speed/s » ({bb and el(bb, "Amount").Text})`)
check(bb and el(bb, "Icon").Image == "rbxassetid://speed-icon", "G1e icône : celle de SpeedRow du HUD")
local rowScale = bb and scaleNamed(el(bb, "Row"), "GainScale")
check(rowScale ~= nil and near(rowScale.Scale, F.PopFrom, 1e-6), `G1f Row part de {F.PopFrom}`)
local offset0 = bb.StudsOffset
check(math.abs(offset0.X) <= F.SpreadX + 1e-6 and near(offset0.Y, 3, 1e-6), "G1g décalage au hasard de ± SpreadX, au StudsOffset de Clément")
step(0.25) -- Quad Out : 44 % du trajet, avant FadeAt (55 %)
check(bb.StudsOffset.Y > 3 + F.Rise * 0.4 and el(bb, "Amount").TextTransparency == 0, "G1h il monte, sans s'effacer avant FadeAt")
step(0.3)
local t = el(bb, "Amount").TextTransparency
check(t > 0 and t < 1 and el(bb, "Icon").ImageTransparency > 0, `G1i puis s'efface (texte {t})`)
step(F.Time)
check(#gains() == 0, "G1j fini : la copie est détruite")

print("\n== G2. Hors machine : rien ; banc : « +X Power »")
P1:SetAttribute("TrainingMachine", nil)
step(1)
P1:SetAttribute("Speed", 20)
check(#gains() == 0, "G2a Speed qui monte hors du tapis : rien")
P1:SetAttribute("TrainingMachine", "Bench")
P1:SetAttribute("Speed", 21)
check(#gains() == 0, "G2b Speed qui monte sur le banc : rien")
P1:SetAttribute("Strength", 6)
list = gains()
check(#list == 0, "G2c a134 : au banc, Strength qui monte : plus de « +X Power » (plus de banc ni de Force)")
P1:SetAttribute("Strength", 4)
check(#gains() == 0, "G2e Strength qui baisse : rien")
step(F.Time + 0.1)

print("\n== G3. Gains rapprochés : un BB_Gain au plus par MinGap")
P1:SetAttribute("TrainingMachine", "Treadmill")
step(1)
P1:SetAttribute("Speed", 23)
step(0.05)
P1:SetAttribute("Speed", 24.5)
step(0.05)
P1:SetAttribute("Speed", 26)
check(#gains() == 1, "G3a trois gains en 0,1 s : un seul BB_Gain d'abord")
step(F.MinGap)
list = gains()
local texts = {}
for _, g in list do
	table.insert(texts, el(g, "Amount").Text)
end
check(#list == 2 and table.find(texts, "+2 Speed/s") and table.find(texts, "+3 Speed/s"), `G3b puis un second avec la somme des deux autres ({table.concat(texts, ", ")})`)
step(F.Time + 0.1)
P1:SetAttribute("TrainingMachine", nil)

print("\n== G4. Ramassage : « +$1.2K », la case vole, l'argent défile à l'arrivée")
played = {}
Motion.SetSoundPlayer(function(name)
	table.insert(played, name)
end)
P1:SetAttribute("Cash", 1300)
P1:SetAttribute("CashCollected", 1200)
step(1 / 30)
check(cash.Text == "$100", `G4a l'argent est retenu pendant le vol (« {cash.Text} »)`)
list = gains()
check(#list == 1 and el(list[1], "Amount").Text == "+$1.2K" and el(list[1], "Icon").Image == "rbxassetid://cash-icon", "G4b « +$1.2K » au-dessus du joueur (icône de CashRow)")
local fl = flyers()
check(#fl == 1 and fl[1].Visible and el(fl[1], "FlyerAmount").Text == "$1.2K", "G4c une copie de CashFly.Template, visible, « $1.2K », à la racine de UI_HUD")
local template = el(el(hud, "CashFly"), "Template")
check(template.Visible == false and el(template, "FlyerAmount").Text == "$0", "G4d le Template de Clément n'est pas touché")
-- Départ : au-dessus du joueur (projection du faux Roblox, IgnoreGuiInset = true : viewport).
local start = fl[1] and fl[1].Position
local expected = Workspace.CurrentCamera:WorldToViewportPoint(root.Position + Vector3.new(0, F.Height, 0))
check(start and near(start.X.Offset, expected.X, 1e-3) and near(start.Y.Offset, expected.Y, 1e-3), "G4e départ au-dessus du joueur")
local flyScale = fl[1] and scaleNamed(fl[1], "GainScale")
step(FLY.PopTime)
check(flyScale and near(flyScale.Scale, FLY.PopTo, 1e-3), `G4f elle surgit jusqu'à × {FLY.PopTo}`)
step(FLY.Hold + FLY.Time / 2)
check(cash.Text == "$100" and #flyers() == 1, "G4g en vol : l'argent ne bouge pas encore")
step(FLY.Time / 2 + 1 / 15)
check(#flyers() == 0, "G4h arrivée : la case est détruite")
local bump = scaleNamed(cashRow, UiMotionC.PopScaleName)
check(bump ~= nil, "G4i CashRow sursaute (CashBump)")
local p = pops()
check(#p == 1 and p[1].Visible and p[1].Text == "+$1.2K", "G4j CounterPop « +$1.2K » à côté du compteur")
local expectedX = cash.AbsolutePosition.X + 60 + POP.OffsetX
check(p[1] and near(p[1].Position.X.Offset, expectedX, 1e-3), "G4k à droite du nombre (TextBounds + OffsetX)")
check(table.find(played, FLY.Sound) ~= nil, `G4l son {FLY.Sound} à l'arrivée`)
local seen = watchTexts(cash, UiMotionC.Roll.Time + 0.05)
check(cash.Text == "$1.3K" and #seen >= 3, `G4m l'argent défile jusqu'à « $1.3K » ({table.concat(seen, " ")})`)
step(BUMP.Time)
check(countClass(cashRow, "UIScale") == 0, "G4n CashRow : UIScale retiré")
step(POP.Hold + POP.FadeTime + 0.2)
check(#pops() == 0, "G4o CounterPop parti")
step(F.Time)

-- a192 (vague 59, L-184 point 3) : récompense = « +$X » qui monte au centre, pause, billets qui volent vers Cash.
local BILL = requireModule(ReplicatedStorage.Shared.Config.HeistFeel, "client").BillFly
local BILL_TOTAL = BILL.RiseTime + BILL.Pause + BILL.FlyTime + BILL.Stagger * BILL.Bills
print("\n== G5. Récompense (UI_Rewards ouvert) : billets qui volent (a192)")
Rewards.open = true
P1:SetAttribute("Cash", 2300)
step(1 / 30)
check(#gains() == 0, "G5b pas de BB_Gain au-dessus du joueur")
check(cash.Text == "$1.3K", "G5c l'argent est retenu")
local gp = pops()
check(#gp == 1 and gp[1].Text == "+$1K" and #flyers() == 0, "G5a « +$1K » au départ (CounterPop de repli), pas encore de billet")
step(BILL.RiseTime + BILL.Pause + 0.05)
check(#flyers() >= 1 and cash.Text == "$1.3K", `G5f billets en vol (CashFly.Template de repli : {#flyers()}), argent toujours retenu`)
step(BILL_TOTAL - BILL.RiseTime - BILL.Pause + 0.1)
check(#flyers() == 0 and #pops() == 1 and pops()[1].Text == "+$1K", "G5d arrivée : billets partis, « +$1K » à côté du compteur")
step(UiMotionC.Roll.Time + 0.05)
check(cash.Text == "$2.3K", "G5e puis « $2.3K »")
Rewards.open = false
step(POP.Hold + POP.FadeTime + 0.3)

print("\n== G5i. Prime de l'index (UI_Index allumé) : billets aussi (a192)")
local indexScreen = new("ScreenGui", { Name = "UI_Index_v3", Enabled = true })
indexScreen.Parent = PLAYER_GUI
P1:SetAttribute("Cash", 2400)
step(1 / 30)
check(cash.Text == "$2.3K" and #pops() == 1, "G5i1 retenu, « +$100 » au départ")
step(BILL_TOTAL + UiMotionC.Roll.Time + 0.2)
check(cash.Text == "$2.4K" and #flyers() == 0, "G5i2 arrivé : « $2.4K »")
indexScreen.Enabled = false
step(POP.Hold + POP.FadeTime + 0.3)
P1:SetAttribute("Cash", 2300)
step(1)

print("\n== G6. Autre gain : le compteur sursaute, sans case")
P1:SetAttribute("Cash", 3300)
step(1 / 30)
check(#flyers() == 0, "G6a aucune case")
check(scaleNamed(cashRow, UiMotionC.PopScaleName) ~= nil, "G6b CashRow sursaute")
step(1 / 30)
local v = parseMoney(cash.Text)
check(v and v > 2300 and v < 3300, `G6c l'argent défile tout de suite ({cash.Text})`)
step(1)
check(cash.Text == "$3.3K" and countClass(cashRow, "UIScale") == 0, "G6d « $3.3K », rien n'est laissé")

print("\n== G7. Dépense : rien ne vole ni ne sursaute")
P1:SetAttribute("Cash", 3000)
step(1 / 30)
check(#flyers() == 0 and scaleNamed(cashRow, UiMotionC.PopScaleName) == nil, "G7a ni case ni sursaut")
step(1)
check(cash.Text == "$3K", "G7b « $3K »")

print("\n== G8. Deux ramassages rapprochés : une seule case, montant cumulé")
P1:SetAttribute("Cash", 3500)
P1:SetAttribute("CashCollected", 1700)
step(0.1)
P1:SetAttribute("Cash", 4000)
P1:SetAttribute("CashCollected", 2200)
step(1 / 30)
fl = flyers()
check(#fl == 1 and el(fl[1], "FlyerAmount").Text == "$1K", `G8a une case, « $1K » ({#fl} case(s))`)
check(cash.Text == "$3K", "G8b l'argent d'avant les deux gains reste affiché")
step(FLY_TOTAL + 0.05)
p = pops()
check(#flyers() == 0 and #p == 1 and p[1].Text == "+$1K", "G8c une arrivée, « +$1K »")
step(UiMotionC.Roll.Time + 0.05)
check(cash.Text == "$4K", "G8d puis « $4K »")
-- Un ramassage pendant le vol d'un autre : deux cases, l'argent monte par étapes.
step(POP.Hold + POP.FadeTime + 0.3)
P1:SetAttribute("Cash", 5000)
P1:SetAttribute("CashCollected", 3200)
step(FLY.PopTime + FLY.Hold + 0.05) -- la première est partie
P1:SetAttribute("Cash", 6000)
P1:SetAttribute("CashCollected", 4200)
step(1 / 30)
check(#flyers() == 2, "G8e un gain pendant le vol : une seconde case")
step(FLY.Time + 0.05)
check(#flyers() == 1, "G8f la première arrive")
local peak = 0
for _ = 1, 9 do -- 0,3 s : la seconde case est encore en l'air
	step(1 / 30)
	peak = math.max(peak, parseMoney(cash.Text) or 0)
end
check(peak > 4000 and peak <= 5000, `G8g l'argent monte, sans dépasser la première (au plus {peak} $)`)
step(FLY_TOTAL)
step(UiMotionC.Roll.Time + 0.05)
check(cash.Text == "$6K" and #pops() == 1, "G8h puis jusqu'à la seconde, une seule CounterPop à la fois")

print("\n== G9. Rien n'est laissé")
step(3)
check(#gains() == 0 and #flyers() == 0 and #pops() == 0, "G9a aucune copie restante")
local active = Gain.GetActive()
check(active.Gains == 0 and active.Flyers == 0 and active.Pops == 0, `G9b GetActive : 0 partout ({active.Gains}, {active.Flyers}, {active.Pops})`)
local allowed = { [cash] = { Text = true }, [el(hud, "Income")] = { Text = true } }
for _, name in { "Speed", "Strength", "Damage" } do
	allowed[el(hud, name)] = { Text = true }
end
local same, why = sameAs(hudSnap, hud, allowed)
check(same, `G9c UI_HUD comme au départ, textes des nombres mis à part ({why})`)
same, why = sameAs(gainSnap, BB_GAIN)
check(same, `G9d BB_Gain de Clément intact ({why})`)
check(ACTIVE_TWEENS() == 0, "G9e aucun tween en cours")
check(not logHas("retenu plus de"), "G9f aucune retenue de l'argent oubliée")

summary()
