---------------------------------------------------------------- scénario « motion » : Motion.Button, Success, HoverCard, Pop
local Motion = requireModule(MOTION_MODULE, "client")
local played = {}
Motion.SetSoundPlayer(function(name)
	table.insert(played, { name = name, t = Workspace:GetServerTimeNow() })
end)
local H, P, R, S, C = UiMotionC.Hover, UiMotionC.Press, UiMotionC.Release, UiMotionC.Success, UiMotionC.HoverCard

local gui = new("ScreenGui", { Name = "UI_Test" }, PLAYER_GUI)
local root = new("Frame", { Name = "Root", Size = UDim2.fromScale(0.5, 0.5) }, gui)
local buy = new("TextButton", { Name = "BuyButton", Size = UDim2.fromScale(0.3, 0.1) }, root)
local shade = new("Frame", { Name = "Shade", BackgroundTransparency = 1, Size = UDim2.fromScale(1, 1) }, buy)
local own = new("TextButton", { Name = "OwnScaleButton", Size = UDim2.fromScale(0.3, 0.1) }, root)
local clementScale = new("UIScale", { Name = "UIScale", Scale = 0.8 }, own)
local card = new("TextButton", { Name = "Card_01", Size = UDim2.fromScale(0.2, 0.3) }, root)
local icon = new("ImageLabel", { Name = "Icon", Position = UDim2.fromScale(0.5, 0.4), Rotation = 3, Size = UDim2.fromScale(0.6, 0.6) }, card)
local outline = new("Frame", { Name = "HoverOutline", Visible = false }, card)
local snap = snapshot(gui)

print("\n== M1. Survol, appui, relâché (Hover, Press, Release)")
Motion.Button(buy)
Motion.Hover(buy) -- ancien nom : sans effet la deuxième fois
buy.MouseEnter:Fire()
step(H.Time + 1 / 30)
local scale = scaleNamed(buy, H.ScaleName)
check(scale ~= nil and near(scale.Scale, H.To, 1e-4), `M1a survol : × {H.To} en {H.Time} s ({scale and scale.Scale})`)
check(near(shade.BackgroundTransparency, H.ShadeTransparency, 1e-4), `M1b Shade à {H.ShadeTransparency} au survol`)
check(#played == 1 and played[1].name == H.Sound, `M1c son {H.Sound} au survol`)
check(countClass(buy, "UIScale") == 1, "M1d un seul UIScale sur le bouton")
buy.MouseButton1Down:Fire()
step(P.Time + 1 / 30)
check(near(scale.Scale, P.To, 1e-4) and near(shade.BackgroundTransparency, P.ShadeTransparency, 1e-4), `M1e appui : × {P.To}, Shade {P.ShadeTransparency}`)
buy.MouseButton1Up:Fire()
step(1 / 30)
check(scale.Scale > P.To, "M1f relâché : il remonte")
step(R.Time)
check(scaleNamed(buy, H.ScaleName) == scale and near(scale.Scale, H.To, 1e-4), "M1g relâché sous la souris : retour au survol (même UIScale)")
buy.MouseLeave:Fire()
step(H.Time + 1 / 30)
check(scaleNamed(buy, H.ScaleName) == nil and countClass(buy, "UIScale") == 0, "M1h souris sortie : UIScale retiré, rien n'est laissé")
check(shade.BackgroundTransparency == 1, "M1i Shade remis à sa transparence d'origine (1)")
-- Appui puis sortie sans relâcher : retour à 1, Release ignoré.
buy.MouseEnter:Fire()
buy.MouseButton1Down:Fire()
buy.MouseLeave:Fire()
buy.MouseButton1Up:Fire()
step(R.Time + H.Time + 0.1)
check(countClass(buy, "UIScale") == 0 and shade.BackgroundTransparency == 1, "M1j appui puis sortie : tout revient, rien n'est laissé")

print("\n== M2. Bouton qui a déjà un UIScale (celui de Clément)")
Motion.Button(own)
own.MouseEnter:Fire()
own.MouseButton1Down:Fire()
step(0.3)
check(clementScale.Scale == 0.8 and countClass(own, "UIScale") == 1, "M2a son UIScale n'est jamais touché, aucun autre n'est ajouté")
own.MouseButton1Up:Fire()
own.MouseLeave:Fire()
step(0.3)

print("\n== M3. Réussite (Success)")
local before = #played
local t0 = Workspace:GetServerTimeNow()
Motion.Success(buy)
local s = scaleNamed(buy, H.ScaleName)
check(s ~= nil and near(s.Scale, S.From, 1e-6), `M3a le bouton saute à × {S.From}`)
step(S.Time / 2)
check(s.Scale < S.From and s.Scale > 0.9, `M3b puis revient ({s.Scale})`)
step(S.Time / 2 + 0.1)
check(countClass(buy, "UIScale") == 0, "M3c revenu à 1 : UIScale retiré")
local success = played[before + 1]
check(success ~= nil and success.name == S.Sound and near(success.t - t0, S.SoundDelay, 0.04), `M3d son {S.Sound} {S.SoundDelay} s après le clic`)

print("\n== M4. Carte survolée (HoverCard)")
Motion.HoverCard(card)
card.MouseEnter:Fire()
step(C.Time + 1 / 30)
local iconScale = scaleNamed(icon, H.ScaleName)
check(outline.Visible == true, "M4a HoverOutline visible au survol")
check(iconScale ~= nil and near(iconScale.Scale, C.IconScale, 1e-4), `M4b Icon × {C.IconScale}`)
check(near(icon.Rotation, 3 + C.Tilt, 1e-4), `M4c Icon penché de {C.Tilt}° ({icon.Rotation})`)
check(sameUDim2(icon.Position, UDim2.fromScale(0.5 + C.ShiftX, 0.4 + C.ShiftY)), "M4d Icon décalé de (ShiftX ; ShiftY)")
card.MouseLeave:Fire()
check(outline.Visible == false, "M4e souris sortie : HoverOutline caché tout de suite")
step(C.BackTime + 1 / 30)
check(icon.Rotation == 3 and sameUDim2(icon.Position, UDim2.fromScale(0.5, 0.4)), "M4f Icon revenu exactement (Rotation, Position)")
check(countClass(icon, "UIScale") == 0, "M4g UIScale de l'Icon retiré")
-- Sortie pendant l'entrée, puis réentrée pendant le retour : la base d'origine reste la bonne.
card.MouseEnter:Fire()
step(C.Time / 2)
card.MouseLeave:Fire()
step(C.BackTime / 3)
card.MouseEnter:Fire()
step(C.Time / 2)
card.MouseLeave:Fire()
step(C.BackTime + 0.1)
check(icon.Rotation == 3 and sameUDim2(icon.Position, UDim2.fromScale(0.5, 0.4)) and countClass(icon, "UIScale") == 0, "M4h survols hachés : tout revient à l'origine")

print("\n== M5. Sursaut passager (Pop)")
local badge = new("Frame", { Name = "Badge" }, root)
local info = TweenInfo.new(UiMotionC.CashBump.Time, UiMotionC.CashBump.Style, UiMotionC.CashBump.Direction)
Motion.Pop(badge, UiMotionC.CashBump.From, info)
local pop = scaleNamed(badge, UiMotionC.PopScaleName)
check(pop ~= nil and near(pop.Scale, UiMotionC.CashBump.From, 1e-6), "M5a sursaut : l'échelle part de From")
step(UiMotionC.CashBump.Time / 2)
Motion.Pop(badge, UiMotionC.CashBump.From, info)
check(scaleNamed(badge, UiMotionC.PopScaleName) == pop and near(pop.Scale, UiMotionC.CashBump.From, 1e-6) and countClass(badge, "UIScale") == 1, "M5b nouveau sursaut pendant le premier : il repart de From, même UIScale")
step(UiMotionC.CashBump.Time + 0.05)
check(countClass(badge, "UIScale") == 0, "M5c fini : UIScale retiré")
Motion.Pop(own, 1.2, info)
check(clementScale.Scale == 0.8 and countClass(own, "UIScale") == 1, "M5d objet qui a son UIScale : rien")
badge:Destroy()

print("\n== M6. Rien n'est laissé")
step(1)
local same, why = sameAs(snap, gui)
check(same, `M6a écran identique à l'instantané de départ ({why})`)
check(ACTIVE_TWEENS() == 0, "M6b aucun tween en cours")

summary()
