--!nocheck
-- Scénario « lock » du banc a205 (vague 63, L-202 point 3) : BB_AntiTheft de Clément avec LockIcon (cadenas doré) ;
-- objet posé au sol sous antivol : cadenas montré ; à « UNLOCKED! » : caché. BB_AntiTheft sans LockIcon (ancien) :
-- rien ne casse. Chaîne du banc a178 (lue sur place, voir run.sh).
advance(1000)
local uiFolder = ASSETS:FindFirstChild("UI") or folder(ASSETS, "UI")
local bb = make("BillboardGui", { Name = "BB_AntiTheft", MaxDistance = 10, AlwaysOnTop = false }, uiFolder)
make("TextLabel", { Name = "ItemName", Text = "Giant TV", TextColor3 = Color3.new(1, 1, 1) }, bb)
make("TextLabel", { Name = "TimeLabel", Text = "0:10", TextColor3 = Color3.new(1, 1, 1) }, bb)
local holder = make("Frame", { Name = "Top", Visible = true }, bb)
make("ImageLabel", { Name = "LockIcon", Visible = true }, holder)
startServer()
local ada = join("Ada", nil)
advance(1.5)
buildInventoryUi(ada)
buildHotbarUi(ada)
startClient(ada)
advance(0.5)
local Unbox = clientModule("UnboxController")
local UnboxConfig = sharedModule("Config/Unbox")

section("cadenas doré sur un objet posé au sol")
local uid = bringItem(ada, "Z3_TeleGeante", "Epic", 3)
local entry = placeItemAt(ada, uid, 6, 0)
check(entry and entry.Spot ~= nil, "objet posé au sol, antivol en cours")
local model = floorItemOf(ada, uid)
local gui = model and model:FindFirstChild("BB_AntiTheft", true)
local icon = gui and gui:FindFirstChild("LockIcon", true)
check(icon ~= nil, "copie de BB_AntiTheft avec son LockIcon (cherché par nom, dans un sous-cadre)")
standNear(ada, model:GetPivot().Position)
advance(0.5)
local view = Unbox.GetFloorView(model)
check(view and view.TimeText ~= "UNLOCKED!" and view.LockIcon == true, `sous antivol : cadenas montré ({view and view.TimeText}, {view and tostring(view.LockIcon)})`)
check(icon and icon.Visible == true, "LockIcon.Visible = true")
advance(antiTheftOf("Epic") + 1)
view = Unbox.GetFloorView(model)
check(view and view.TimeText == "UNLOCKED!", `« UNLOCKED! » écrit ({view and view.TimeText})`)
check(view and view.LockIcon == false and icon.Visible == false, "à « UNLOCKED! » : cadenas caché")
advance(1)
check(icon.Visible == false, "reste caché ensuite")
check(gui.Enabled == true and holder.Visible == true, "le reste du billboard reste montré")

section("BB_AntiTheft sans LockIcon : rien ne casse")
uiFolder:FindFirstChild("BB_AntiTheft"):FindFirstChild("Top"):Destroy()
local uid2 = bringItem(ada, "Z3_Smartphone", "Rare", 3)
local entry2 = placeItemAt(ada, uid2, -6, 0)
check(entry2 and entry2.Spot ~= nil, "second objet posé au sol")
local model2 = floorItemOf(ada, uid2)
standNear(ada, model2:GetPivot().Position)
advance(0.5)
local view2 = Unbox.GetFloorView(model2)
check(view2 ~= nil and view2.LockIcon == nil and view2.TimeText ~= nil, "vue sans cadenas (LockIcon nil), minuteur affiché")
advance(antiTheftOf("Rare") + 1)
view2 = Unbox.GetFloorView(model2)
check(view2 and view2.TimeText == "UNLOCKED!", "« UNLOCKED! » sans cadenas, sans erreur")
check(not logHas("ERREUR"), "aucune erreur")

summary("scénario lock")
