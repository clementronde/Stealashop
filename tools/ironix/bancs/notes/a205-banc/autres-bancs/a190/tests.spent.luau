---------------------------------------------------------------- scénario « spent » : décompte de l'argent (L-182 point 4)
local S = HudCfgC.CashSpent
local R = UiMotionC.Roll
P1:SetAttribute("Cash", 1000)
P1:SetAttribute("Income", 10)
P1:SetAttribute("WalkSpeed", 16)
P1:SetAttribute("Damage", 1)
local hud = makeNewHud()
local Hud = requireModule(HUD_MODULE, "client")
taskLib.spawn(Hud.Start)
step(0.1)
local cash = el(hud, "Cash")
local spent = el(hud, "CashSpent")

print("\n== S1. Achat : l'argent décompte en CashSpent.Time, « -$X » à côté")
check(cash.Text == "$1K" and spent.Visible == false, `S1a départ : « $1K », CashSpent caché ({cash.Text})`)
P1:SetAttribute("Cash", 600)
step(1 / 30)
check(spent.Visible and spent.Text == "-$400", `S1b CashSpent « -$400 » montré ({spent.Text})`)
step(R.Time + 0.05) -- au-delà du défilement court : le décompte n'est pas fini
local mid = parseMoney(cash.Text)
check(mid ~= nil and mid > 600 and mid < 1000, `S1c après {R.Time} s, encore en route ({cash.Text})`)
step(S.Time - R.Time)
check(cash.Text == "$600", `S1d au bout de {S.Time} s : « $600 » ({cash.Text})`)
check(spent.Visible, "S1e CashSpent encore là pendant Hold")
step(S.Hold + 0.05)
check(not spent.Visible, "S1f puis caché")

print("\n== S2. Deux achats rapprochés : les montants s'additionnent")
P1:SetAttribute("Cash", 500)
step(0.3)
P1:SetAttribute("Cash", 450)
step(1 / 30)
check(spent.Text == "-$150", `S2a « -$150 » ({spent.Text})`)
step(S.Time - 0.2)
check(spent.Visible, "S2b le 2e achat relance la durée complète")
step(0.2 + S.Hold + 0.1)
check(not spent.Visible and cash.Text == "$450", `S2c fini : « $450 », caché ({cash.Text})`)

print("\n== S3. Un gain garde le défilement court, sans CashSpent")
P1:SetAttribute("Cash", 900)
step(R.Time + 0.05)
check(cash.Text == "$900" and not spent.Visible, `S3a « $900 » en {R.Time} s, CashSpent caché ({cash.Text})`)

print("\n== S4. Argent retenu (gain qui vole) : pas de décompte")
local release = Hud.HoldCash(900)
P1:SetAttribute("Cash", 1200)
step(1 / 30)
release()
step(R.Time + 0.05)
check(cash.Text == "$1.2K" and not spent.Visible, `S4a la retenue relâchée défile vers le haut ({cash.Text})`)

print("\n== S5. Ancien HUD sans CashSpent : le décompte marche, aucune ligne")
hud:Destroy()
local old = makeHud()
step(0.1)
local oldCash = el(old, "Cash")
clearLog()
P1:SetAttribute("Cash", 200)
step(R.Time + 0.05)
local v = parseMoney(oldCash.Text)
check(v ~= nil and v > 200, `S5a décompte lent aussi ({oldCash.Text})`)
step(S.Time)
check(oldCash.Text == "$200", `S5b « $200 » à la fin ({oldCash.Text})`)
check(not logHas("CashSpent"), "S5c aucune ligne sur CashSpent")
summary()
